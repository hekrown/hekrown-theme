<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000000">

  {%- comment -%} Preconnect hints for faster resource loading {%- endcomment -%}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Open Graph / Social Media Tags {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: shop.name }}">
  <meta property="og:type" content="{% if template == 'product' %}product{% elsif template == 'article' %}article{% else %}website{% endif %}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- endif -%}

  {%- comment -%} Twitter Card Tags {%- endcomment -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | default: shop.name }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    {%- comment -%}Prevent 404 when no favicon is set{%- endcomment -%}
    <link rel="icon" href="data:;base64,iVBORw0KGgo=">
  {%- endif -%}

  {%- comment -%} Dynamic theme settings as CSS custom properties {%- endcomment -%}
  <style>
    :root {
      --page-width: {{ settings.page_width | default: 1440 }}px;
      --section-spacing: {{ settings.section_spacing | default: 64 }}px;
      --grid-gap-dynamic: {{ settings.grid_gap | default: 20 }}px;
      --button-radius: {{ settings.button_border_radius | default: 0 }}px;
      --button-border-width: {{ settings.button_border_width | default: 1 }}px;
      --animation-speed: {{ settings.animation_speed | default: '0.4s' }};
      --font-body-scale: {{ settings.font_body_scale | default: 100 }}%;
      --font-heading-scale: {{ settings.font_heading_scale | default: 100 }}%;
      --heading-transform: {{ settings.heading_transform | default: 'none' }};

      /* Color Scheme 1 (default) */
      --color-scheme-1-bg: {{ settings.scheme_1_background | default: '#FFFFFF' }};
      --color-scheme-1-text: {{ settings.scheme_1_text | default: '#333333' }};
      --color-scheme-1-heading: {{ settings.scheme_1_heading | default: '#000000' }};
      --color-scheme-1-btn-bg: {{ settings.scheme_1_button_bg | default: '#000000' }};
      --color-scheme-1-btn-text: {{ settings.scheme_1_button_text | default: '#FFFFFF' }};
      --color-scheme-1-accent: {{ settings.scheme_1_accent | default: '#C0392B' }};

      /* Color Scheme 2 (dark) */
      --color-scheme-2-bg: {{ settings.scheme_2_background | default: '#000000' }};
      --color-scheme-2-text: {{ settings.scheme_2_text | default: '#CCCCCC' }};
      --color-scheme-2-heading: {{ settings.scheme_2_heading | default: '#FFFFFF' }};
      --color-scheme-2-btn-bg: {{ settings.scheme_2_button_bg | default: '#FFFFFF' }};
      --color-scheme-2-btn-text: {{ settings.scheme_2_button_text | default: '#000000' }};
      --color-scheme-2-accent: {{ settings.scheme_2_accent | default: '#E74C3C' }};

      /* Color Scheme 3 (neutral) */
      --color-scheme-3-bg: {{ settings.scheme_3_background | default: '#F5F5F5' }};
      --color-scheme-3-text: {{ settings.scheme_3_text | default: '#333333' }};
      --color-scheme-3-heading: {{ settings.scheme_3_heading | default: '#000000' }};
      --color-scheme-3-btn-bg: {{ settings.scheme_3_button_bg | default: '#333333' }};
      --color-scheme-3-btn-text: {{ settings.scheme_3_button_text | default: '#FFFFFF' }};
      --color-scheme-3-accent: {{ settings.scheme_3_accent | default: '#C0392B' }};
    }

    /* Font scaling */
    body { font-size: calc(14px * var(--font-body-scale) / 100); }
    h1, h2, h3, h4, h5, h6 { text-transform: var(--heading-transform); }

    /* Dynamic button radius */
    .btn, .input, select { border-radius: var(--button-radius); }

    /* Color scheme utility classes */
    .color-scheme-1 {
      background-color: var(--color-scheme-1-bg);
      color: var(--color-scheme-1-text);
      --color-scheme-bg: var(--color-scheme-1-bg);
      --color-scheme-text: var(--color-scheme-1-text);
      --color-scheme-heading: var(--color-scheme-1-heading);
      --color-scheme-btn-bg: var(--color-scheme-1-btn-bg);
      --color-scheme-btn-text: var(--color-scheme-1-btn-text);
      --color-scheme-accent: var(--color-scheme-1-accent);
    }

    .color-scheme-2 {
      background-color: var(--color-scheme-2-bg);
      color: var(--color-scheme-2-text);
      --color-scheme-bg: var(--color-scheme-2-bg);
      --color-scheme-text: var(--color-scheme-2-text);
      --color-scheme-heading: var(--color-scheme-2-heading);
      --color-scheme-btn-bg: var(--color-scheme-2-btn-bg);
      --color-scheme-btn-text: var(--color-scheme-2-btn-text);
      --color-scheme-accent: var(--color-scheme-2-accent);
    }

    .color-scheme-3 {
      background-color: var(--color-scheme-3-bg);
      color: var(--color-scheme-3-text);
      --color-scheme-bg: var(--color-scheme-3-bg);
      --color-scheme-text: var(--color-scheme-3-text);
      --color-scheme-heading: var(--color-scheme-3-heading);
      --color-scheme-btn-bg: var(--color-scheme-3-btn-bg);
      --color-scheme-btn-text: var(--color-scheme-3-btn-text);
      --color-scheme-accent: var(--color-scheme-3-accent);
    }

    /* Apply scheme to buttons within scheme context */
    [class*="color-scheme-"] .btn--primary {
      background-color: var(--color-scheme-btn-bg);
      color: var(--color-scheme-btn-text);
    }

    [class*="color-scheme-"] .btn--secondary {
      color: var(--color-scheme-btn-bg);
      border-color: var(--color-scheme-btn-bg);
    }

    [class*="color-scheme-"] .btn--secondary:hover {
      background-color: var(--color-scheme-btn-bg);
      color: var(--color-scheme-btn-text);
    }

    [class*="color-scheme-"] h1,
    [class*="color-scheme-"] h2,
    [class*="color-scheme-"] h3,
    [class*="color-scheme-"] h4,
    [class*="color-scheme-"] h5,
    [class*="color-scheme-"] h6 {
      color: var(--color-scheme-heading);
    }

    /* Container uses dynamic page width */
    .container { max-width: var(--page-width); }

    /* Section padding uses dynamic spacing */
    .section-padding { padding-block: var(--section-spacing); }
  </style>

  {%- comment -%} Hero image preload — above-fold LCP optimization {%- endcomment -%}
  {%- if template.name == 'index' -%}
    {%- assign hero_section = sections['hero'] -%}
    {%- if hero_section.settings.image != blank -%}
      <link rel="preload" as="image" href="{{ hero_section.settings.image | image_url: width: 1920 }}" fetchpriority="high">
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} CSS Reset + Design Tokens {%- endcomment -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Dynamic font loading from theme settings {%- endcomment -%}
  {%- if settings.font_heading.system? == false -%}
    <link rel="preload" as="font" href="{{ settings.font_heading | font_url }}" type="font/woff2" crossorigin>
  {%- endif -%}
  {%- if settings.font_body.system? == false and settings.font_body.family != settings.font_heading.family -%}
    <link rel="preload" as="font" href="{{ settings.font_body | font_url }}" type="font/woff2" crossorigin>
  {%- endif -%}

  {{ settings.font_heading | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_face: font_display: 'swap' }}

  {%- comment -%} Inject dynamic font CSS variables {%- endcomment -%}
  <style>
    :root {
      --font-heading: {{ settings.font_heading.family | json }}, {{ settings.font_heading.fallback_families }};
      --font-body: {{ settings.font_body.family | json }}, {{ settings.font_body.fallback_families }};
      --font-heading-weight: {{ settings.font_heading.weight }};
      --font-body-weight: {{ settings.font_body.weight }};
    }
  </style>

  {%- comment -%} Component styles {%- endcomment -%}
  {{ 'component-header.css' | asset_url | stylesheet_tag }}
  {{ 'component-footer.css' | asset_url | stylesheet_tag }}
  {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
  {{ 'states.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>

  {%- comment -%} Global theme config — accessible to all JS files {%- endcomment -%}
  <script>
    window.MossTheme = window.MossTheme || {};
    window.MossTheme.moneyFormat = {{ shop.money_format | json }};
    window.MossTheme.currency = {{ cart.currency.iso_code | json }};
    window.MossTheme.locale = {{ request.locale.iso_code | json }};
  </script>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}" data-animations="{{ settings.enable_scroll_animations }}">
  <a class="skip-to-content" href="#main-content">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {% sections 'header-group' %}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- comment -%} Structured Data / JSON-LD {%- endcomment -%}
  {%- if template.name == 'index' -%}
    {% render 'schema-organization' %}
  {%- endif -%}
  {%- if template.name == 'product' -%}
    {% render 'schema-product', product: product %}
  {%- endif -%}
  {% render 'schema-breadcrumbs' %}

  {%- comment -%} Premium features — compare bar, modal, quick view {%- endcomment -%}
  {%- unless template.name == 'gift-card' or template.name == 'password' -%}
    {% render 'compare-ui' %}
    {% render 'quick-view' %}
  {%- endunless -%}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  <script src="{{ 'scroll-reveal.js' | asset_url }}" defer></script>
</body>
</html>
