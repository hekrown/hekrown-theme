{
  "sections": {
    "slideshow": {
      "type": "slideshow",
      "settings": {
        "height": 80,
        "autoplay": true,
        "interval": 5
      },
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "heading": "New Season Collection",
            "subheading": "Refined essentials for the modern wardrobe",
            "button_text": "Shop New Arrivals",
            "button_link": "/collections/new-arrivals",
            "text_position": "bottom-left",
            "text_color": "#FFFFFF"
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "heading": "Linen Wear",
            "subheading": "Lightweight fabrics for every occasion",
            "button_text": "Explore Linen",
            "button_link": "/collections/linen-wear",
            "text_position": "bottom-left",
            "text_color": "#FFFFFF"
          }
        }
      },
      "block_order": ["slide_1", "slide_2"]
    },
    "logo_list": {
      "type": "logo-list",
      "settings": {
        "heading": "As Seen In",
        "color_scheme": "1",
        "logo_height": 28
      },
      "blocks": {
        "logo_1": { "type": "logo", "settings": { "alt": "GQ" } },
        "logo_2": { "type": "logo", "settings": { "alt": "Esquire" } },
        "logo_3": { "type": "logo", "settings": { "alt": "Vogue" } },
        "logo_4": { "type": "logo", "settings": { "alt": "The Times" } },
        "logo_5": { "type": "logo", "settings": { "alt": "Wallpaper" } }
      },
      "block_order": ["logo_1", "logo_2", "logo_3", "logo_4", "logo_5"]
    },
    "collection_grid": {
      "type": "collection-grid",
      "settings": {
        "heading": "Shop by Category",
        "columns": 4
      },
      "blocks": {
        "tile_shirts": { "type": "tile", "settings": { "title": "Shirts", "link": "/collections/shirts" } },
        "tile_linen": { "type": "tile", "settings": { "title": "Linen Wear", "link": "/collections/linen-wear" } },
        "tile_essentials": { "type": "tile", "settings": { "title": "Essentials", "link": "/collections/essentials" } },
        "tile_new": { "type": "tile", "settings": { "title": "New Arrivals", "link": "/collections/new-arrivals" } }
      },
      "block_order": ["tile_shirts", "tile_linen", "tile_essentials", "tile_new"]
    },
    "featured_collection": {
      "type": "featured-collection",
      "settings": {
        "heading": "New Arrivals",
        "collection": "new-arrivals",
        "products_to_show": 4,
        "show_view_all": true
      }
    },
    "image_with_text": {
      "type": "image-with-text",
      "settings": {
        "heading": "Our Story",
        "eyebrow": "Hekrown Fashion",
        "body": "<p>Refined, contemporary clothing crafted for the modern wardrobe. From relaxed linen shirts to tailored essentials — quality you can feel.</p>",
        "button_text": "Discover",
        "button_link": "/pages/about",
        "image_position": "left"
      }
    },
    "testimonials": {
      "type": "testimonials",
      "settings": {
        "heading": "What Our Customers Say",
        "heading_alignment": "center",
        "columns": "3",
        "color_scheme": "3"
      },
      "blocks": {
        "t1": { "type": "testimonial", "settings": { "name": "James T.", "title": "Verified Buyer", "quote": "<p>Excellent quality and fast delivery. The fit is perfect and the fabric feels premium.</p>", "rating": 5 } },
        "t2": { "type": "testimonial", "settings": { "name": "Sarah M.", "title": "Repeat Customer", "quote": "<p>I've ordered multiple times now. Consistent sizing and the linen collection is outstanding.</p>", "rating": 5 } },
        "t3": { "type": "testimonial", "settings": { "name": "David R.", "title": "First-time Buyer", "quote": "<p>Impressed with the attention to detail. Will definitely be ordering again.</p>", "rating": 4 } }
      },
      "block_order": ["t1", "t2", "t3"]
    },
    "featured_collection_2": {
      "type": "featured-collection",
      "settings": {
        "heading": "Bestsellers",
        "collection": "shirts",
        "products_to_show": 4,
        "show_view_all": true
      }
    },
    "newsletter": {
      "type": "newsletter",
      "settings": {
        "heading": "Stay in the Loop",
        "description": "Subscribe to receive updates, access to exclusive deals, and more.",
        "button_text": "Subscribe",
        "color_scheme": "2",
        "layout": "text-only"
      }
    },
    "usp_bar": {
      "type": "usp-bar",
      "settings": {}
    }
  },
  "order": [
    "slideshow",
    "logo_list",
    "collection_grid",
    "featured_collection",
    "image_with_text",
    "testimonials",
    "featured_collection_2",
    "newsletter",
    "usp_bar"
  ]
}
