{%- comment -%}
  Commerce Block: Product Description
  Renders the product description, optionally as an accordion.
{%- endcomment -%}

{%- if product.description != blank -%}
  {%- if block.settings.collapsible -%}
    <details class="block-product-desc__accordion"{% if block.settings.open_by_default %} open{% endif %}>
      <summary class="block-product-desc__trigger">
        {{ block.settings.heading | default: 'Description' }}
      </summary>
      <div class="block-product-desc__content rte">
        {{ product.description }}
      </div>
    </details>
  {%- else -%}
    {%- if block.settings.heading != blank -%}
      <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); margin-bottom: var(--space-sm);">
        {{ block.settings.heading }}
      </h3>
    {%- endif -%}
    <div class="block-product-desc__content rte" style="font-size: var(--font-size-base); line-height: var(--line-height-normal); color: var(--color-scheme-text, var(--color-dark-grey));">
      {{ product.description }}
    </div>
  {%- endif -%}
{%- endif -%}

<style>
  .block-product-desc__accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .block-product-desc__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-md) 0;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    list-style: none;
  }

  .block-product-desc__trigger::-webkit-details-marker { display: none; }

  .block-product-desc__trigger::after {
    content: '+';
    font-size: 18px;
    transition: transform var(--transition-fast);
  }

  .block-product-desc__accordion[open] .block-product-desc__trigger::after {
    content: '−';
  }

  .block-product-desc__content {
    padding-bottom: var(--space-md);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
  }

  .block-product-desc__content p { margin-bottom: var(--space-md); }
  .block-product-desc__content p:last-child { margin-bottom: 0; }
</style>

{% schema %}
{
  "name": "Product description",
  "tag": "div",
  "class": "theme-block--product-description",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Description"
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Show as collapsible accordion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ]
}
{% endschema %}
