{%- doc -%}
  Theme Block: Spacer
  Adjustable vertical whitespace between blocks.
  @param {range} height - Height of the spacer in px
{%- enddoc -%}

<div class="block-spacer" {{ block.shopify_attributes }} style="height: {{ block.settings.height }}px;" aria-hidden="true"></div>

{% schema %}
{
  "name": "Spacer",
  "tag": null,
  "class": "theme-block--spacer",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 4,
      "max": 120,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ]
}
{% endschema %}
