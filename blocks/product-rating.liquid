{%- doc -%}
  Commerce Block: Product Rating
  Displays star rating sourced from product metafields.
  Compatible with Judge.me, Shopify Product Reviews, and Yotpo.
  Renders nothing if no rating metafield is present.
  Context: Requires `product` object (use inside product sections).
{%- enddoc -%}

{%- if product.metafields.reviews.rating.value -%}
  <div class="block-product-rating" {{ block.shopify_attributes }} style="display: flex; align-items: center; gap: var(--space-sm);">
    <div class="block-product-rating__stars" aria-label="{{ product.metafields.reviews.rating.value }} out of 5 stars">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24" width="14" height="14" style="display: inline-block;">
          <polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            fill="{% if i <= product.metafields.reviews.rating.value %}var(--color-scheme-heading, var(--color-black)){% else %}var(--color-border){% endif %}"
            stroke="none"
          />
        </svg>
      {%- endfor -%}
    </div>
    <span style="font-size: var(--font-size-sm); color: var(--color-mid-grey);">
      ({{ product.metafields.reviews.rating_count | default: 0 }} reviews)
    </span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product rating",
  "tag": null,
  "class": "theme-block--product-rating",
  "settings": []
}
{% endschema %}
