{%- doc -%}
  Theme Block: Custom Liquid
  Escape hatch for power users — renders raw Liquid code.
  Use for advanced customizations not covered by other blocks.
  @param {liquid} code - Raw Liquid code to render
{%- enddoc -%}

<div {{ block.shopify_attributes }}>
  {{ block.settings.code }}
</div>

{% schema %}
{
  "name": "Custom Liquid",
  "tag": null,
  "class": "theme-block--liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "code",
      "label": "Custom Liquid",
      "info": "Add custom Liquid code. Use for advanced customizations."
    }
  ]
}
{% endschema %}
