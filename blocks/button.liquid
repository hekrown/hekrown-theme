{%- comment -%}
  Theme Block: Button
  Configurable CTA button — primary, secondary, or text link.
{%- endcomment -%}

{%- if block.settings.label != blank -%}
  <div class="block-button" style="text-align: {{ block.settings.alignment }};">
    <a
      href="{{ block.settings.link }}"
      class="btn btn--{{ block.settings.style }}{% if block.settings.full_width %} btn--full-width{% endif %}"
      style="
        {%- if block.settings.size == 'small' -%}padding: 10px 20px; font-size: 11px;{%- endif -%}
        {%- if block.settings.size == 'large' -%}padding: 18px 40px; font-size: 14px;{%- endif -%}
      "
    >
      {{ block.settings.label }}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "tag": "div",
  "class": "theme-block--button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "secondary", "label": "Secondary (outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    }
  ]
}
{% endschema %}
