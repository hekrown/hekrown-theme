{%- doc -%}
  Theme Block: Button
  Configurable CTA button — primary, secondary, or text link styles.
  Supports size, alignment, and full-width options.

  @param {text} label - Button label text
  @param {url} link - Button destination URL
  @param {select} style - Visual style: primary (filled) or secondary (outline)
  @param {select} size - Size preset: small, default, or large
  @param {select} alignment - Alignment of the button wrapper
  @param {checkbox} full_width - Whether button fills full container width
{%- enddoc -%}

{%- if block.settings.label != blank -%}
  <div
    class="block-button"
    {{ block.shopify_attributes }}
    style="text-align: {{ block.settings.alignment }};"
  >
    <a
      href="{{ block.settings.link }}"
      class="btn btn--{{ block.settings.style }}{% if block.settings.full_width %} btn--full-width{% endif %}"
      style="
        {%- if block.settings.size == 'small' -%}padding: 10px 20px; font-size: 11px;{%- endif -%}
        {%- if block.settings.size == 'large' -%}padding: 18px 40px; font-size: 14px;{%- endif -%}
      "
    >
      {{ block.settings.label }}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "tag": null,
  "class": "theme-block--button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "secondary", "label": "Secondary (outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.style != 'text' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false,
      "visible_if": "{{ block.settings.style != 'text' }}"
    }
  ]
}
{% endschema %}
