{%- comment -%}
  Free Shipping Progress Bar
  Shows how much more the customer needs to spend for free shipping.
  Uses settings.cart_shipping_threshold from theme settings.
  Include in cart drawer and cart page.
  Usage: {% render 'free-shipping-bar', cart: cart %}
{%- endcomment -%}

{%- if settings.cart_show_shipping_bar -%}
  {%- liquid
    assign threshold_cents = settings.cart_shipping_threshold | default: '200' | times: 100
    assign cart_total = cart.total_price
    assign remaining = threshold_cents | minus: cart_total
    assign progress = cart_total | times: 100 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
  -%}

  <div class="shipping-bar" data-shipping-bar data-threshold="{{ threshold_cents }}">
    {%- if remaining <= 0 -%}
      <div class="shipping-bar__message shipping-bar__message--success">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>You've unlocked <strong>free shipping!</strong></span>
      </div>
    {%- else -%}
      <div class="shipping-bar__message">
        <span>Spend <strong data-shipping-remaining>{{ remaining | money }}</strong> more for <strong>free shipping</strong></span>
      </div>
    {%- endif -%}

    <div class="shipping-bar__track">
      <div class="shipping-bar__fill" style="width: {{ progress }}%;" data-shipping-fill></div>
    </div>
  </div>

  <style>
    .shipping-bar {
      padding: var(--space-md) 0;
    }

    .shipping-bar__message {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      font-size: var(--font-size-sm);
      margin-bottom: var(--space-sm);
      color: var(--color-dark-grey);
    }

    .shipping-bar__message--success {
      color: #27AE60;
    }

    .shipping-bar__track {
      width: 100%;
      height: 4px;
      background-color: var(--color-border);
      overflow: hidden;
    }

    .shipping-bar__fill {
      height: 100%;
      background-color: #27AE60;
      transition: width var(--transition-normal);
    }
  </style>
{%- endif -%}
