{%- comment -%}
  Product Card Component
  Used in: collection grid, featured collection, recommendations, search.
  Accepts: product (product object)
{%- endcomment -%}

{%- liquid
  assign has_second_image = false
  if product.media[1]
    assign has_second_image = true
  endif

  assign color_option = nil
  assign size_option  = nil
  for option in product.options_with_values
    if option.name == 'Colour' or option.name == 'Color'
      assign color_option = option
    endif
    if option.name == 'Size'
      assign size_option = option
    endif
  endfor
-%}

<article class="product-card" data-product-card>
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title | escape }}" tabindex="0">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="product-card__image product-card__image--primary"
          width="600"
          height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
          loading="lazy"
        >
        {%- if has_second_image -%}
          <img
            src="{{ product.media[1] | image_url: width: 600 }}"
            alt="{{ product.media[1].alt | escape }}"
            class="product-card__image product-card__image--hover"
            width="600"
            height="{{ 600 | divided_by: product.media[1].aspect_ratio | round }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__placeholder"></div>
      {%- endif -%}

      {%- comment -%} Badges {%- endcomment -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__badge product-card__badge--sale">{{ 'products.general.sale' | t }}</span>
      {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
        <span class="product-card__badge product-card__badge--new">{{ 'products.general.new' | t }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Wishlist toggle {%- endcomment -%}
    <button
      class="product-card__wishlist"
      data-wishlist-toggle="{{ product.id }}"
      aria-label="Add to wishlist"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    {%- comment -%} Quick Add button — appears on hover {%- endcomment -%}
    {%- unless product.has_only_default_variant -%}
      <div class="product-card__quick-add" data-quick-add>
        <button
          class="product-card__quick-add-btn"
          aria-label="Quick add {{ product.title | escape }}"
          aria-expanded="false"
          data-quick-add-toggle
        >
          {{ 'products.product.quick_add' | t }}
        </button>
        <div class="product-card__size-picker" aria-hidden="true" data-size-picker>
          {%- if size_option -%}
            {%- for value in size_option.values -%}
              {%- assign variant_available = false -%}
              {%- for variant in product.variants -%}
                {%- if variant.option1 == value or variant.option2 == value or variant.option3 == value -%}
                  {%- if variant.available -%}
                    {%- assign variant_available = true -%}
                    {%- assign quick_variant_id = variant.id -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              <button
                class="product-card__size-btn{% unless variant_available %} product-card__size-btn--unavailable{% endunless %}"
                data-quick-add-size="{{ quick_variant_id }}"
                {% unless variant_available %}disabled{% endunless %}
                aria-label="Add size {{ value }} to basket"
              >
                {{ value }}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} No size option — single add {%- endcomment -%}
            <button
              class="product-card__size-btn"
              data-quick-add-size="{{ product.first_available_variant.id }}"
            >
              {{ 'products.product.add_to_cart' | t }}
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      {%- comment -%} Default variant — direct add {%- endcomment -%}
      <div class="product-card__quick-add" data-quick-add>
        <button
          class="product-card__quick-add-btn"
          data-quick-add-size="{{ product.first_available_variant.id }}"
          aria-label="Add {{ product.title | escape }} to basket"
        >
          Add to Basket
        </button>
      </div>
    {%- endunless -%}
  </div>

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ product.title }}</h3>
    </a>

    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price-sale">{{ product.price | money }}</span>
        <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>

    {%- comment -%} Colour swatches — real CSS colour circles {%- endcomment -%}
    {%- if color_option -%}
      <div class="product-card__swatches" aria-label="Available colours">
        {%- for value in color_option.values -%}
          <a
            href="{{ product.url }}?variant={{ product.variants | where: 'option1', value | map: 'id' | first }}"
            class="product-card__swatch"
            title="{{ value }}"
            aria-label="{{ value }}"
            style="background-color: {{ value | handleize | replace: '-', '' }};"
          ></a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>

<style>
  .product-card {
    position: relative;
  }

  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-off-white);
  }

  .product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .product-card__image-link:hover .product-card__image--primary {
    transform: scale(1.04);
  }

  .product-card__image-link:hover .product-card__image--hover {
    opacity: 1;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-off-white);
  }

  /* Badges */
  .product-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    padding: 4px 8px;
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    z-index: 2;
  }

  .product-card__badge--sale { background-color: var(--color-red); color: var(--color-white); }
  .product-card__badge--new  { background-color: var(--color-black); color: var(--color-white); }

  /* Wishlist toggle */
  .product-card__wishlist {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 3;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-white);
    border: none;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition-fast), background-color var(--transition-fast);
  }

  .product-card__image-wrapper:hover .product-card__wishlist,
  .product-card__wishlist:focus,
  .product-card__wishlist.is-wishlisted {
    opacity: 1;
  }

  .product-card__wishlist svg path {
    transition: fill var(--transition-fast);
  }

  .product-card__wishlist.is-wishlisted svg path {
    fill: var(--color-black);
    stroke: var(--color-black);
  }

  .product-card__wishlist:hover svg path {
    fill: var(--color-black);
    stroke: var(--color-black);
  }

  /* Quick Add */
  .product-card__quick-add {    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    transform: translateY(100%);
    transition: transform var(--transition-normal);
  }

  .product-card__image-wrapper:hover .product-card__quick-add,
  .product-card__quick-add:focus-within {
    transform: translateY(0);
  }

  .product-card__quick-add-btn {
    width: 100%;
    padding: 12px;
    background-color: var(--color-black);
    color: var(--color-white);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    border: none;
    transition: background-color var(--transition-fast);
  }

  .product-card__quick-add-btn:hover {
    background-color: var(--color-dark-grey);
  }

  /* Size picker panel */
  .product-card__size-picker {
    display: none;
    flex-wrap: wrap;
    gap: 4px;
    padding: var(--space-sm);
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  .product-card__size-picker.is-open {
    display: flex;
  }

  .product-card__size-btn {
    flex: 1;
    min-width: 40px;
    padding: 8px 4px;
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    text-align: center;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .product-card__size-btn:hover:not(:disabled) {
    background-color: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  .product-card__size-btn--unavailable {
    opacity: 0.35;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* Info */
  .product-card__info {
    padding-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card__title-link {
    text-decoration: none;
    color: inherit;
  }

  .product-card__title-link:hover .product-card__title {
    text-decoration: underline;
  }

  .product-card__title {
    font-size: 13px;
    font-weight: var(--font-weight-medium);
    color: var(--color-black);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  .product-card__price {
    font-size: 13px;
    font-weight: var(--font-weight-medium);
  }

  .product-card__price-sale    { color: var(--color-red); }
  .product-card__price-compare { text-decoration: line-through; color: var(--color-mid-grey); font-weight: var(--font-weight-regular); margin-left: var(--space-xs); }

  /* Colour swatches */
  .product-card__swatches {
    display: flex;
    gap: 4px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .product-card__swatch {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .product-card__swatch:hover {
    transform: scale(1.2);
    border-color: var(--color-black);
  }
</style>

<script>
(function () {
  // Quick Add — toggle size picker, then AJAX add to cart
  document.querySelectorAll('[data-quick-add]').forEach(function (qa) {
    var toggleBtn  = qa.querySelector('[data-quick-add-toggle]');
    var sizePicker = qa.querySelector('[data-size-picker]');
    var sizeBtns   = qa.querySelectorAll('[data-quick-add-size]');

    // If there's a toggle button (multi-variant), show size picker on click
    if (toggleBtn && sizePicker) {
      toggleBtn.addEventListener('click', function (e) {
        e.preventDefault();
        var isOpen = sizePicker.classList.toggle('is-open');
        toggleBtn.setAttribute('aria-expanded', isOpen);
        sizePicker.setAttribute('aria-hidden', !isOpen);
      });
    }

    // Size button click — add to cart via AJAX
    sizeBtns.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var variantId = btn.dataset.quickAddSize;
        if (!variantId) return;

        btn.textContent = '...';
        btn.disabled = true;

        MossCart.addItem(parseInt(variantId, 10), 1)
          .then(function () {
            return MossCart.getCart();
          })
          .then(function (cart) {
            dispatchCartUpdate(cart);
            btn.textContent = '✓ Added';
            setTimeout(function () {
              btn.textContent = btn.dataset.originalText || 'Add';
              btn.disabled = false;
              if (sizePicker) {
                sizePicker.classList.remove('is-open');
                if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
              }
            }, 1500);
          })
          .catch(function () {
            btn.textContent = 'Error';
            btn.disabled = false;
          });
      });

      // Store original text
      btn.dataset.originalText = btn.textContent;
    });
  });
})();
</script>
