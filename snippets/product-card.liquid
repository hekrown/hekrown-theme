{%- comment -%}
  Product Card Component
  Used in: collection grid, featured collection, recommendations, search.
  Accepts: product (product object)
{%- endcomment -%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title }}">
    <div class="product-card__image-wrapper">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="product-card__image product-card__image--primary"
          width="600"
          height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
          loading="lazy"
        >
        {%- if product.media[1] -%}
          <img
            src="{{ product.media[1] | image_url: width: 600 }}"
            alt="{{ product.media[1].alt | escape }}"
            class="product-card__image product-card__image--hover"
            width="600"
            height="{{ 600 | divided_by: product.media[1].aspect_ratio | round }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__placeholder"></div>
      {%- endif -%}

      {%- comment -%} Badges {%- endcomment -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__badge product-card__badge--sale">Sale</span>
      {%- elsif product.tags contains 'new' -%}
        <span class="product-card__badge product-card__badge--new">New</span>
      {%- endif -%}
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title }}</h3>
      <div class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__price-sale">{{ product.price | money }}</span>
          <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
        {%- else -%}
          <span>{{ product.price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Colour swatches (if product has Color option) {%- endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Colour' or option.name == 'Color' -%}
          <div class="product-card__swatches">
            {%- for value in option.values -%}
              <span
                class="product-card__swatch"
                title="{{ value }}"
                style="background-color: {{ value | handleize }};"
              ></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </a>
</article>

<style>
  .product-card {
    position: relative;
  }

  .product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-off-white);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .product-card__link:hover .product-card__image--primary {
    transform: scale(1.04);
  }

  .product-card__link:hover .product-card__image--hover {
    opacity: 1;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-off-white);
  }

  /* Badges */
  .product-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    padding: 4px 8px;
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .product-card__badge--sale {
    background-color: var(--color-red);
    color: var(--color-white);
  }

  .product-card__badge--new {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  /* Info */
  .product-card__info {
    padding-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card__title {
    font-size: 13px;
    font-weight: var(--font-weight-medium);
    color: var(--color-black);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  .product-card__price {
    font-size: 13px;
    font-weight: var(--font-weight-medium);
  }

  .product-card__price-sale {
    color: var(--color-red);
  }

  .product-card__price-compare {
    text-decoration: line-through;
    color: var(--color-mid-grey);
    font-weight: var(--font-weight-regular);
    margin-left: var(--space-xs);
  }

  /* Swatches */
  .product-card__swatches {
    display: flex;
    gap: 4px;
    margin-top: 4px;
  }

  .product-card__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }
</style>
