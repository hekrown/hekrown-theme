{%- comment -%}
  Cart Upsell / Cross-sell
  Shows product recommendations inside the cart drawer footer.
  Uses Shopify's complementary products API.
  Replaces: ReConvert, Bold Upsell ($20-30/mo)
  Usage: {% render 'cart-upsell' %}
{%- endcomment -%}

<div class="cart-upsell" data-cart-upsell style="display: none;">
  <div class="cart-upsell__header">
    <h3 class="cart-upsell__title">Complete Your Look</h3>
  </div>
  <div class="cart-upsell__items" data-cart-upsell-items></div>
</div>

<style>
  .cart-upsell {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-sm);
  }

  .cart-upsell__title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--space-md);
  }

  .cart-upsell__items {
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    padding-bottom: var(--space-sm);
    -webkit-overflow-scrolling: touch;
  }

  .cart-upsell__item {
    flex: 0 0 140px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cart-upsell__item-img {
    width: 140px;
    height: 175px;
    object-fit: cover;
    background-color: var(--color-off-white);
    display: block;
  }

  .cart-upsell__item-title {
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    color: var(--color-black);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-upsell__item-price {
    font-size: 11px;
    color: var(--color-mid-grey);
  }

  .cart-upsell__item-add {
    margin-top: 4px;
    padding: 6px 12px;
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    background: var(--color-black);
    color: var(--color-white);
    border: none;
    cursor: pointer;
    text-align: center;
    width: 100%;
  }

  .cart-upsell__item-add:hover {
    background: var(--color-dark-grey);
  }
</style>

<script>
(function () {
  'use strict';

  var upsellEl = document.querySelector('[data-cart-upsell]');
  var itemsEl  = document.querySelector('[data-cart-upsell-items]');
  if (!upsellEl || !itemsEl) return;

  // Listen for cart updates to fetch complementary products
  document.addEventListener('cart:updated', function (e) {
    var cart = e.detail.cart;
    if (!cart || cart.item_count === 0) {
      upsellEl.style.display = 'none';
      return;
    }

    // Use the first item's product to fetch recommendations
    var firstItem = cart.items[0];
    if (!firstItem) return;

    var productId = firstItem.product_id;
    var url = '/recommendations/products.json?product_id=' + productId + '&limit=4&intent=complementary';

    fetch(url)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var products = data.products || [];
        // Filter out products already in cart
        var cartProductIds = cart.items.map(function (i) { return i.product_id; });
        products = products.filter(function (p) { return cartProductIds.indexOf(p.id) === -1; });

        if (products.length === 0) {
          upsellEl.style.display = 'none';
          return;
        }

        upsellEl.style.display = '';
        itemsEl.innerHTML = products.slice(0, 4).map(function (p) {
          var img = p.images[0] ? p.images[0].src : '';
          var price = formatMoney(p.price);
          var variantId = p.variants[0].id;

          return '<div class="cart-upsell__item">' +
            (img ? '<img src="' + img + '" alt="' + p.title + '" class="cart-upsell__item-img" loading="lazy" width="140" height="175">' : '') +
            '<span class="cart-upsell__item-title">' + p.title + '</span>' +
            '<span class="cart-upsell__item-price">' + price + '</span>' +
            '<button class="cart-upsell__item-add" data-upsell-add="' + variantId + '">+ Add</button>' +
          '</div>';
        }).join('');

        // Add to cart buttons
        itemsEl.querySelectorAll('[data-upsell-add]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var vid = parseInt(btn.dataset.upsellAdd, 10);
            btn.textContent = '...';
            btn.disabled = true;
            MossCart.addItem(vid, 1)
              .then(function () { return MossCart.getCart(); })
              .then(function (cart) {
                dispatchCartUpdate(cart);
                btn.textContent = '✓ Added';
              })
              .catch(function () {
                btn.textContent = 'Error';
                btn.disabled = false;
              });
          });
        });
      })
      .catch(function () {
        upsellEl.style.display = 'none';
      });
  });

  function formatMoney(cents) {
    try { return new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(Number(cents) / 100); }
    catch (e) { return '£' + (Number(cents) / 100).toFixed(2); }
  }
})();
</script>
