{%- comment -%}
  Logo List Section
  "As seen in" or brand partners — grayscale logos with hover color.
{%- endcomment -%}

<div class="section-logo-list section-padding color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <p class="section-logo-list__heading">{{ section.settings.heading }}</p>
    {%- endif -%}

    <div class="section-logo-list__grid" style="--logo-height: {{ section.settings.logo_height }}px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' -%}
          <div class="section-logo-list__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.alt | default: 'Partner logo' }}">{%- endif -%}
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 300 }}"
                  alt="{{ block.settings.alt | escape | default: '' }}"
                  height="{{ section.settings.logo_height }}"
                  width="{{ section.settings.logo_height | times: block.settings.image.aspect_ratio | round }}"
                  loading="lazy"
                  class="section-logo-list__logo"
                >
              {%- else -%}
                <div class="section-logo-list__placeholder"></div>
              {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-logo-list__heading {
    text-align: center;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-scheme-text, var(--color-mid-grey));
    margin-bottom: var(--space-lg);
  }

  .section-logo-list__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-xl);
  }

  .section-logo-list__logo {
    height: var(--logo-height, 32px);
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter var(--transition-normal), opacity var(--transition-normal);
  }

  .section-logo-list__item:hover .section-logo-list__logo {
    filter: grayscale(0%);
    opacity: 1;
  }

  .section-logo-list__placeholder {
    height: var(--logo-height, 32px);
    width: 100px;
    background-color: var(--color-border);
    opacity: 0.3;
  }
</style>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "class": "logo-list-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen In"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (px)",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Brand 1" } },
        { "type": "logo", "settings": { "alt": "Brand 2" } },
        { "type": "logo", "settings": { "alt": "Brand 3" } },
        { "type": "logo", "settings": { "alt": "Brand 4" } },
        { "type": "logo", "settings": { "alt": "Brand 5" } }
      ]
    }
  ]
}
{% endschema %}
