{%- comment -%}
  Collection Banner / Header
{%- endcomment -%}

<div class="collection-banner color-scheme-{{ section.settings.color_scheme }}" style="{% if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' %}background-color: {{ section.settings.background_color }};{% endif %}padding-top:{{ section.settings.padding_top | default: 40 }}px;padding-bottom:{{ section.settings.padding_bottom | default: 64 }}px;">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>
    <h1 class="collection-banner__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="collection-banner__description">{{ collection.description }}</p>
    {%- endif -%}
  </div>
</div>

<style>
  .collection-banner {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .collection-banner__title {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: var(--font-weight-bold);
    margin-top: var(--space-md);
  }

  .collection-banner__description {
    font-size: var(--font-size-base);
    color: var(--color-mid-grey);
    margin-top: var(--space-sm);
    max-width: 600px;
  }
</style>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "collection-banner-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour override",
      "info": "Leave blank to use color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 8, "default": 40, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 8, "default": 64, "unit": "px"
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ]
}
{% endschema %}
