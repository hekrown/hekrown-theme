{%- comment -%}
  Moss Sticky Hero Section
  A full-screen sticky background section supporting video (native Shopify video)
  and image fallbacks. Text links overlay at the bottom-left corner and scroll up.
{%- endcomment -%}

<div
  class="sticky-hero"
  data-sticky-hero
  data-overlay-opacity="{{ section.settings.overlay_opacity | divided_by: 100.0 }}"
>
  <div class="sticky-hero__bg-wrapper">
    {%- if section.settings.video != blank or section.settings.video_mobile != blank -%}
      {%- comment -%} Desktop Video {%- endcomment -%}
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: "sticky-hero__video sticky-hero__video--desktop" }}
      {%- endif -%}

      {%- comment -%} Mobile Video {%- endcomment -%}
      {%- if section.settings.video_mobile != blank -%}
        {{ section.settings.video_mobile | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: "sticky-hero__video sticky-hero__video--mobile" }}
      {%- else -%}
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: "sticky-hero__video sticky-hero__video--mobile" }}
        {%- endif -%}
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 768 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          alt="{{ section.settings.image.alt | default: 'Hero background' | escape }}"
          class="sticky-hero__image"
          loading="eager"
          width="1920"
          height="{{ 1920 | divided_by: section.settings.image.aspect_ratio | round }}"
        >
      </picture>
    {%- else -%}
      <img
        src="{{ 'hero-bg.jpg' | asset_url }}"
        alt="Hero background"
        class="sticky-hero__image"
        loading="eager"
        width="1920"
        height="1080"
      >
    {%- endif -%}

    <div class="sticky-hero__overlay" style="background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  </div>

  <div class="sticky-hero__content-wrapper">
    <div class="sticky-hero__links-list">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank and block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="sticky-hero__link" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .sticky-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  /* Sticky background wrapper */
  .sticky-hero__bg-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    z-index: 1;
  }

  .sticky-hero__video,
  .sticky-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Responsive video logic */
  .sticky-hero__video--desktop {
    display: block;
  }
  .sticky-hero__video--mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-hero__video--desktop {
      display: none;
    }
    .sticky-hero__video--mobile {
      display: block;
    }
  }

  .sticky-hero__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-off-white);
  }

  .sticky-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sticky-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    transition: background-color 0.1s linear;
  }

  /* Content wrapper pulls links up over the sticky background */
  .sticky-hero__content-wrapper {
    position: relative;
    z-index: 3;
    margin-top: -100vh;
    margin-top: -100dvh;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--space-xl) var(--container-padding-mobile);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .sticky-hero__content-wrapper {
      padding: var(--space-3xl) var(--container-padding);
    }
  }

  .sticky-hero__links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    pointer-events: auto;
  }

  @media (min-width: 1024px) {
    .sticky-hero__links-list {
      gap: var(--space-sm);
    }
  }

  .sticky-hero__link {
    font-size: clamp(24px, 4.5vw, 38px);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
    text-decoration: none;
    text-transform: capitalize;
    width: fit-content;
    line-height: 1.1;
    transition: opacity var(--transition-fast);
  }

  .sticky-hero__link:hover {
    opacity: 0.7;
    text-decoration: none;
  }
</style>

<script>
  (function() {
    'use strict';

    function initStickyHero() {
      const hero = document.querySelector('[data-sticky-hero]');
      if (!hero) return;

      const overlay = hero.querySelector('.sticky-hero__overlay');
      if (!overlay) return;

      const initialOpacity = parseFloat(hero.dataset.overlayOpacity) || 0;
      const maxAdditionalOpacity = 0.3; // darkens by up to 30% on scroll

      const updateOverlay = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const maxScroll = window.innerHeight || 600;
        const progress = Math.min(scrollTop / maxScroll, 1);

        const newOpacity = initialOpacity + (progress * maxAdditionalOpacity);
        overlay.style.backgroundColor = `rgba(0, 0, 0, ${newOpacity.toFixed(2)})`;
      };

      window.addEventListener('scroll', updateOverlay, { passive: true });
      window.addEventListener('resize', updateOverlay);
      updateOverlay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyHero);
    } else {
      initStickyHero();
    }
  })();
</script>

{% schema %}
{
  "name": "Sticky Hero",
  "tag": "section",
  "class": "shopify-section--sticky-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image fallback"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image fallback"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (base)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 15,
      "unit": "%"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "link",
      "name": "Quick Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "New In"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link target"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky Hero",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "New In",
            "link": "/collections/new-arrivals"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Suits",
            "link": "/collections/new-arrivals"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Shirts",
            "link": "/collections/shirts"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Linen Wear",
            "link": "/collections/linen-wear"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Essentials",
            "link": "/collections/essentials"
          }
        }
      ]
    }
  ]
}
{% endschema %}
