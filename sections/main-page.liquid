<div class="page-content section-padding color-scheme-{{ section.settings.color_scheme }}" style="padding-top:{{ section.settings.padding_top | default: 64 }}px;padding-bottom:{{ section.settings.padding_bottom | default: 64 }}px;">
  <div class="container">
    <h1 class="page-content__title">{{ page.title }}</h1>
    <div class="page-content__body">
      {{ page.content }}
    </div>
  </div>
</div>

<style>
  .page-content__title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-xl);
  }

  .page-content__body {
    max-width: 720px;
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
  }

  .page-content__body h2,
  .page-content__body h3 {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .page-content__body p {
    margin-bottom: var(--space-md);
  }
</style>

{% schema %}
{
  "name": "Page content",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 8, "default": 64, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 8, "default": 64, "unit": "px"
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ]
}
{% endschema %}
