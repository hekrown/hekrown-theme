{%- comment -%}
  Countdown Timer Section
  Urgency element for sales, launches, and limited-time offers.
  Supports fixed end date or evergreen (daily reset) mode.
{%- endcomment -%}

<div class="section-countdown section-padding color-scheme-{{ section.settings.color_scheme }}">
  <div class="container section-countdown__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-countdown__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="section-countdown__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div
      class="section-countdown__timer"
      data-countdown
      data-end-date="{{ section.settings.end_date }}"
      data-evergreen="{{ section.settings.evergreen }}"
      data-evergreen-hours="{{ section.settings.evergreen_hours }}"
    >
      <div class="countdown__unit">
        <span class="countdown__number" data-countdown-days>00</span>
        <span class="countdown__label">Days</span>
      </div>
      <span class="countdown__separator">:</span>
      <div class="countdown__unit">
        <span class="countdown__number" data-countdown-hours>00</span>
        <span class="countdown__label">Hours</span>
      </div>
      <span class="countdown__separator">:</span>
      <div class="countdown__unit">
        <span class="countdown__number" data-countdown-minutes>00</span>
        <span class="countdown__label">Minutes</span>
      </div>
      <span class="countdown__separator">:</span>
      <div class="countdown__unit">
        <span class="countdown__number" data-countdown-seconds>00</span>
        <span class="countdown__label">Seconds</span>
      </div>
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="section-countdown__cta">
        <a href="{{ section.settings.button_link }}" class="btn btn--primary">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}

    <p class="section-countdown__expired" data-countdown-expired style="display: none;">
      {{ section.settings.expired_message | default: 'This offer has ended.' }}
    </p>
  </div>
</div>

<style>
  .section-countdown__inner {
    text-align: center;
    max-width: 800px;
    margin-inline: auto;
  }

  .section-countdown__heading {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-sm);
    color: var(--color-scheme-heading, inherit);
  }

  .section-countdown__subheading {
    font-size: var(--font-size-base);
    margin-bottom: var(--space-xl);
    color: var(--color-scheme-text, var(--color-mid-grey));
  }

  .section-countdown__cta {
    margin-top: var(--space-xl);
  }

  .section-countdown__timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 72px;
  }

  .countdown__number {
    font-size: clamp(32px, 6vw, 56px);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-scheme-heading, var(--color-black));
    font-variant-numeric: tabular-nums;
  }

  .countdown__label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-scheme-text, var(--color-mid-grey));
    margin-top: var(--space-xs);
  }

  .countdown__separator {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: var(--font-weight-bold);
    color: var(--color-scheme-heading, var(--color-black));
    opacity: 0.4;
    align-self: flex-start;
    margin-top: 4px;
  }
</style>

<script>
(function () {
  'use strict';

  document.querySelectorAll('[data-countdown]').forEach(function (el) {
    var daysEl    = el.querySelector('[data-countdown-days]');
    var hoursEl   = el.querySelector('[data-countdown-hours]');
    var minutesEl = el.querySelector('[data-countdown-minutes]');
    var secondsEl = el.querySelector('[data-countdown-seconds]');
    var expiredEl = el.closest('.section-countdown').querySelector('[data-countdown-expired]');

    var endDate;
    var isEvergreen = el.dataset.evergreen === 'true';

    if (isEvergreen) {
      var hours = parseInt(el.dataset.evergreenHours, 10) || 24;
      var storageKey = 'moss_countdown_' + el.closest('section').id;
      var stored = localStorage.getItem(storageKey);

      if (stored && new Date(stored) > new Date()) {
        endDate = new Date(stored);
      } else {
        endDate = new Date(Date.now() + hours * 60 * 60 * 1000);
        localStorage.setItem(storageKey, endDate.toISOString());
      }
    } else {
      endDate = new Date(el.dataset.endDate);
    }

    function update() {
      var now = new Date();
      var diff = endDate - now;

      if (diff <= 0) {
        el.style.display = 'none';
        if (expiredEl) expiredEl.style.display = '';
        return;
      }

      var d = Math.floor(diff / (1000 * 60 * 60 * 24));
      var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var s = Math.floor((diff % (1000 * 60)) / 1000);

      daysEl.textContent    = String(d).padStart(2, '0');
      hoursEl.textContent   = String(h).padStart(2, '0');
      minutesEl.textContent = String(m).padStart(2, '0');
      secondsEl.textContent = String(s).padStart(2, '0');

      requestAnimationFrame(function () { setTimeout(update, 1000); });
    }

    update();
  });
})();
</script>

{% schema %}
{
  "name": "Countdown timer",
  "tag": "section",
  "class": "countdown-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sale Ends Soon"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't miss out on our biggest sale of the season"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (YYYY-MM-DD HH:MM)",
      "info": "Leave blank if using evergreen mode",
      "default": "2026-12-31 23:59"
    },
    {
      "type": "checkbox",
      "id": "evergreen",
      "label": "Evergreen mode (resets per visitor)",
      "info": "Overrides end date. Each visitor gets their own countdown.",
      "default": false
    },
    {
      "type": "range",
      "id": "evergreen_hours",
      "label": "Evergreen duration (hours)",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 24,
      "unit": "h"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This offer has ended."
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Countdown timer"
    }
  ]
}
{% endschema %}
