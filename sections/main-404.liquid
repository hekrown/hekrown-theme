<div class="page-404 section-padding">
  <div class="container text-center">
    <h1>Page not found</h1>
    <p style="color: var(--color-mid-grey); margin-top: var(--space-md);">
      Sorry, the page you're looking for doesn't exist.
    </p>
    <a href="{{ routes.root_url }}" class="btn btn--primary" style="margin-top: var(--space-xl);">
      Return to Homepage
    </a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "settings": []
}
{% endschema %}
