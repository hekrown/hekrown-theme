{%- comment -%}
  Store Finder Section
  Black left panel: heading, description, CTA button.
  Right: store image.
  Mirrors Moss.co.uk "Find your nearest store" section.
{%- endcomment -%}

<div class="store-finder">
  {%- comment -%} Left — black text panel {%- endcomment -%}
  <div class="store-finder__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="store-finder__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="store-finder__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="store-finder__btn">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} Right — store image {%- endcomment -%}
  <div class="store-finder__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000 }}"
        alt="{{ section.settings.image.alt | default: 'Our store' | escape }}"
        class="store-finder__img"
        loading="lazy"
        width="1000"
        height="{{ 1000 | divided_by: section.settings.image.aspect_ratio | round }}"
      >
    {%- else -%}
      <div class="store-finder__placeholder"></div>
    {%- endif -%}
  </div>
</div>

<style>
  .store-finder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 400px;
    background-color: var(--color-black);
  }

  @media (max-width: 639px) {
    .store-finder {
      grid-template-columns: 1fr;
    }
  }

  /* Left content */
  .store-finder__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-2xl) var(--space-xl);
    gap: var(--space-lg);
  }

  .store-finder__heading {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    line-height: var(--line-height-snug);
  }

  .store-finder__body {
    font-size: var(--font-size-sm);
    color: var(--color-footer-subtext);
    line-height: var(--line-height-normal);
    max-width: 360px;
  }

  .store-finder__btn {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-white);
    text-decoration: none;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-white);
    padding-bottom: 2px;
    width: fit-content;
    transition: opacity var(--transition-fast);
  }

  .store-finder__btn:hover {
    opacity: 0.7;
    text-decoration: none;
  }

  /* Right image */
  .store-finder__media {
    position: relative;
    overflow: hidden;
  }

  .store-finder__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .store-finder__placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #1a1a1a;
  }
</style>

{% schema %}
{
  "name": "Store Finder",
  "tag": "section",
  "class": "store-finder-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your nearest store"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Visit one of our stores for customisations, fittings & styling advice."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Book An Appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Store image"
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Store Finder",
      "settings": {
        "heading": "Find your nearest store",
        "body": "Visit one of our stores for customisations, fittings & styling advice.",
        "button_text": "Book An Appointment",
        "button_link": "/pages/contact"
      }
    }
  ]
}
{% endschema %}
