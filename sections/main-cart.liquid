{%- comment -%}
  Main Cart Section
  Two-column: 65% line items, 35% order summary (sticky).
{%- endcomment -%}

<div class="cart-page section-padding" data-cart-page>
  <div class="container">
    <h1 class="cart-page__heading">Your Basket</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty" data-cart-empty>
        <p>Your basket is empty</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue Shopping</a>
      </div>
    {%- else -%}
      <div class="cart-page__grid" data-cart-grid>
        {%- comment -%} Line Items {%- endcomment -%}
        <div class="cart-page__items" data-cart-items>
          {%- for item in cart.items -%}
            <div class="cart-page__item" data-cart-item="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-page__item-image">
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.title | escape }}"
                  width="80"
                  height="100"
                  loading="lazy"
                >
              </a>
              <div class="cart-page__item-details">
                <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                <p class="cart-page__item-variant">
                  {%- for option in item.options_with_values -%}
                    {{ option.name }}: {{ option.value }}{% unless forloop.last %} | {% endunless %}
                  {%- endfor -%}
                </p>
                <p class="cart-page__item-price" data-item-price="{{ item.key }}">{{ item.final_price | money }}</p>

                <div class="cart-page__item-actions">
                  <div class="cart-page__item-qty">
                    <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
                    <span data-qty-value>{{ item.quantity }}</span>
                    <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                  </div>
                  <button type="button" class="cart-page__item-remove" data-remove-item>Remove</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Order Summary {%- endcomment -%}
        <div class="cart-page__summary">
          <div class="cart-page__summary-box">
            <h2 class="cart-page__summary-heading">Order Summary</h2>

            <div class="cart-page__summary-row">
              <span>Subtotal</span>
              <span data-cart-subtotal>{{ cart.total_price | money }}</span>
            </div>

            <div class="cart-page__summary-row">
              <span>Delivery</span>
              <span>Calculated at checkout</span>
            </div>

            {%- comment -%} Discount code {%- endcomment -%}
            <div class="cart-page__discount">
              <input type="text" placeholder="Discount code" class="input" data-discount-input>
              <button type="button" class="btn btn--secondary">Apply</button>
            </div>

            <div class="cart-page__summary-total">
              <span>Total</span>
              <span data-cart-total>{{ cart.total_price | money }}</span>
            </div>

            <a href="/checkout" class="btn btn--primary btn--full-width cart-page__checkout-btn">
              Proceed to Checkout
            </a>

            <div class="cart-page__payment-icons">
              {{ shop.enabled_payment_types | payment_type_svg_tag }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  /* Loading state — dims items while AJAX is in flight */
  .cart-page--loading .cart-page__items {
    opacity: 0.4;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  /* Flash highlight on updated price */
  @keyframes cart-price-flash {
    0%   { background-color: transparent; }
    30%  { background-color: #f0f0f0; }
    100% { background-color: transparent; }
  }

  .cart-price-updated {
    animation: cart-price-flash 0.6s ease;
  }

  .cart-page__heading {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-xl);
  }

  .cart-page__empty {
    text-align: center;
    padding: var(--space-3xl) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .cart-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .cart-page__grid {
      grid-template-columns: 1fr 380px;
      gap: var(--space-2xl);
    }
  }

  .cart-page__item {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-page__item-image img {
    width: 80px;
    height: 100px;
    object-fit: cover;
    background-color: var(--color-off-white);
  }

  .cart-page__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .cart-page__item-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-black);
    text-decoration: none;
  }

  .cart-page__item-title:hover {
    text-decoration: underline;
  }

  .cart-page__item-variant {
    font-size: var(--font-size-sm);
    color: var(--color-mid-grey);
  }

  .cart-page__item-price {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
  }

  .cart-page__item-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .cart-page__item-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
  }

  .cart-page__item-qty button {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .cart-page__item-qty span {
    width: 32px;
    text-align: center;
    font-size: var(--font-size-sm);
  }

  .cart-page__item-remove {
    font-size: var(--font-size-sm);
    color: var(--color-mid-grey);
    text-decoration: underline;
  }

  /* Summary */
  .cart-page__summary {
    position: relative;
  }

  @media (min-width: 1024px) {
    .cart-page__summary {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }

  .cart-page__summary-box {
    border: 1px solid var(--color-border);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cart-page__summary-heading {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
  }

  .cart-page__summary-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-base);
  }

  .cart-page__discount {
    display: flex;
    gap: var(--space-sm);
  }

  .cart-page__discount .input {
    flex: 1;
    height: 40px;
  }

  .cart-page__discount .btn {
    padding: 8px 16px;
    font-size: var(--font-size-sm);
  }

  .cart-page__summary-total {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .cart-page__checkout-btn {
    height: var(--button-height);
    font-size: var(--font-size-base);
  }

  .cart-page__payment-icons {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
  }

  .cart-page__payment-icons svg {
    height: 24px;
    width: auto;
  }
</style>

<script>
(function () {
  'use strict';

  var cartPage = document.querySelector('[data-cart-page]');
  if (!cartPage) return;

  // ── Money formatting ─────────────────────────────────────────────────────
  // Shopify returns cents — format as £X.XX using the store's currency symbol
  function formatMoney(cents) {
    var amount = (cents / 100).toFixed(2);
    // Use Intl if available, otherwise simple fallback
    try {
      return new Intl.NumberFormat('en-GB', {
        style: 'currency',
        currency: 'GBP'
      }).format(cents / 100);
    } catch (e) {
      return '£' + amount;
    }
  }

  // ── Set loading state ────────────────────────────────────────────────────
  function setLoading(on) {
    cartPage.classList.toggle('cart-page--loading', on);
  }

  // ── Update totals in the summary panel ──────────────────────────────────
  function updateTotals(cart) {
    var subtotalEl = document.querySelector('[data-cart-subtotal]');
    var totalEl    = document.querySelector('[data-cart-total]');
    var formatted  = formatMoney(cart.total_price);

    if (subtotalEl) {
      subtotalEl.textContent = formatted;
      subtotalEl.classList.add('cart-price-updated');
      subtotalEl.addEventListener('animationend', function () {
        subtotalEl.classList.remove('cart-price-updated');
      }, { once: true });
    }
    if (totalEl) {
      totalEl.textContent = formatted;
      totalEl.classList.add('cart-price-updated');
      totalEl.addEventListener('animationend', function () {
        totalEl.classList.remove('cart-price-updated');
      }, { once: true });
    }

    // Update header cart count badge
    dispatchCartUpdate(cart);
  }

  // ── Show empty state when all items removed ──────────────────────────────
  function showEmptyState() {
    var grid  = document.querySelector('[data-cart-grid]');
    var empty = document.querySelector('[data-cart-empty]');

    if (grid) {
      grid.remove();
    }

    if (!empty) {
      var container = cartPage.querySelector('.container');
      var emptyDiv  = document.createElement('div');
      emptyDiv.className = 'cart-page__empty';
      emptyDiv.setAttribute('data-cart-empty', '');
      emptyDiv.innerHTML =
        '<p>Your basket is empty</p>' +
        '<a href="/collections/all" class="btn btn--primary">Continue Shopping</a>';
      container.appendChild(emptyDiv);
    }
  }

  // ── Remove a line item row from the DOM ──────────────────────────────────
  function removeItemRow(key) {
    var row = document.querySelector('[data-cart-item="' + key + '"]');
    if (row) {
      row.style.transition = 'opacity 0.3s ease, max-height 0.3s ease';
      row.style.opacity    = '0';
      row.style.overflow   = 'hidden';
      row.style.maxHeight  = row.offsetHeight + 'px';
      requestAnimationFrame(function () {
        row.style.maxHeight = '0';
        row.style.padding   = '0';
      });
      row.addEventListener('transitionend', function () {
        row.remove();
      }, { once: true });
    }
  }

  // ── Update quantity display for an item ──────────────────────────────────
  function updateItemQty(key, newQty) {
    var row    = document.querySelector('[data-cart-item="' + key + '"]');
    if (!row) return;
    var qtyEl  = row.querySelector('[data-qty-value]');
    if (qtyEl) qtyEl.textContent = newQty;
  }

  // ── AJAX: change item quantity ───────────────────────────────────────────
  function changeQty(key, newQty) {
    setLoading(true);

    MossCart.updateItem(key, newQty)
      .then(function (cart) {
        if (newQty === 0) {
          removeItemRow(key);
          if (cart.item_count === 0) {
            showEmptyState();
            return;
          }
        } else {
          updateItemQty(key, newQty);
        }
        updateTotals(cart);
      })
      .catch(function (err) {
        console.error('Cart update failed:', err);
      })
      .finally(function () {
        setLoading(false);
      });
  }

  // ── Attach events to a single item row ──────────────────────────────────
  function bindItemEvents(row) {
    var key      = row.dataset.cartItem;
    var minusBtn = row.querySelector('[data-qty-minus]');
    var plusBtn  = row.querySelector('[data-qty-plus]');
    var qtyEl    = row.querySelector('[data-qty-value]');
    var removeBtn = row.querySelector('[data-remove-item]');

    if (minusBtn) {
      minusBtn.addEventListener('click', function () {
        var current = parseInt(qtyEl.textContent, 10) || 1;
        var newQty  = Math.max(0, current - 1);
        changeQty(key, newQty);
      });
    }

    if (plusBtn) {
      plusBtn.addEventListener('click', function () {
        var current = parseInt(qtyEl.textContent, 10) || 1;
        changeQty(key, current + 1);
      });
    }

    if (removeBtn) {
      removeBtn.addEventListener('click', function () {
        changeQty(key, 0);
      });
    }
  }

  // ── Bind all item rows on page load ─────────────────────────────────────
  document.querySelectorAll('[data-cart-item]').forEach(function (row) {
    bindItemEvents(row);
  });

})();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "main-cart-section",
  "settings": [],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
