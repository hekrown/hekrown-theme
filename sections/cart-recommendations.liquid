{%- comment -%}
  Cart Recommendations — cross-sell below cart
{%- endcomment -%}

<div class="cart-recommendations section-padding">
  <div class="container">
    <h2 class="cart-recommendations__heading">{{ section.settings.heading }}</h2>
    <p class="cart-recommendations__placeholder" style="color: var(--color-mid-grey); font-size: var(--font-size-sm);">
      Recommendations will appear here based on cart contents.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Cart recommendations",
  "tag": "section",
  "class": "cart-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    }
  ]
}
{% endschema %}
