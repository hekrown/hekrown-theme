{%- comment -%}
  Carousel Section
  Universal carousel for products, collections, or content slides.
  Auto-play, prev/next arrows, dots, touch/swipe support.
  Each slide is a block with image, heading, text, and button.
{%- endcomment -%}

{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
-%}

<div
  class="carousel-section{% if section.settings.color_scheme != blank %} color-scheme-{{ section.settings.color_scheme }}{% endif %}"
  style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;"
>
  <div class="{% if section.settings.full_width %}{% else %}container{% endif %}">

    {%- if section.settings.heading != blank -%}
      <h2 class="carousel-section__heading" style="text-align: {{ section.settings.heading_align }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="carousel" data-carousel data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
      <div class="carousel__track" data-carousel-track>
        {%- for block in section.blocks -%}
          <div class="carousel__slide" data-carousel-slide {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="carousel__slide-media" style="aspect-ratio: {{ section.settings.image_ratio }}; overflow: hidden;">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.heading | default: block.settings.image.alt | escape }}"
                  width="1200"
                  height="{{ 1200 | divided_by: block.settings.image.aspect_ratio | round }}"
                  loading="lazy"
                  style="width:100%;height:100%;object-fit:cover;display:block;"
                >
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
              <div class="carousel__slide-content">
                {%- if block.settings.heading != blank -%}
                  <h3 class="carousel__slide-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="carousel__slide-text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link }}" class="btn btn--{{ block.settings.button_style }}">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polyline points="15 18 9 12 15 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
        </button>
        <button class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polyline points="9 18 15 12 9 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
        </button>

        <div class="carousel__dots" role="tablist" data-carousel-dots>
          {%- for block in section.blocks -%}
            <button class="carousel__dot{% if forloop.first %} carousel__dot--active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Slide {{ forloop.index }}" data-dot-index="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .carousel-section__heading {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-xl);
    color: var(--color-scheme-heading, var(--color-black));
  }

  .carousel {
    position: relative;
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .carousel__slide {
    min-width: 100%;
    flex-shrink: 0;
  }

  .carousel__slide-content {
    padding: var(--space-lg) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .carousel__slide-heading {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-scheme-heading, var(--color-black));
  }

  .carousel__slide-text {
    font-size: var(--font-size-base);
    color: var(--color-scheme-text, var(--color-dark-grey));
    line-height: var(--line-height-normal);
  }

  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .carousel__arrow:hover { background-color: var(--color-black); color: var(--color-white); }
  .carousel__arrow--prev { left: var(--space-md); }
  .carousel__arrow--next { right: var(--space-md); }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
  }

  .carousel__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background-color: var(--color-border);
    border: none; cursor: pointer;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    padding: 0;
  }

  .carousel__dot--active {
    background-color: var(--color-black);
    transform: scale(1.3);
  }
</style>

<script>
(function() {
  var carousel = document.querySelector('[data-carousel]');
  if (!carousel) return;

  var track = carousel.querySelector('[data-carousel-track]');
  var slides = Array.from(carousel.querySelectorAll('[data-carousel-slide]'));
  var dots = Array.from(carousel.querySelectorAll('[data-dot-index]'));
  var prevBtn = carousel.querySelector('[data-carousel-prev]');
  var nextBtn = carousel.querySelector('[data-carousel-next]');
  var current = 0;
  var autoplay = carousel.dataset.autoplay !== 'false';
  var interval = parseInt(carousel.dataset.interval, 10) || 5000;
  var timer;

  function goTo(index) {
    index = (index + slides.length) % slides.length;
    track.style.transform = 'translateX(-' + (index * 100) + '%)';
    if (dots[current]) { dots[current].classList.remove('carousel__dot--active'); dots[current].setAttribute('aria-selected', 'false'); }
    current = index;
    if (dots[current]) { dots[current].classList.add('carousel__dot--active'); dots[current].setAttribute('aria-selected', 'true'); }
  }

  function startTimer() { if (!autoplay || slides.length <= 1) return; timer = setInterval(function() { goTo(current + 1); }, interval); }
  function resetTimer() { clearInterval(timer); startTimer(); }

  if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); resetTimer(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); resetTimer(); });
  dots.forEach(function(dot) { dot.addEventListener('click', function() { goTo(parseInt(dot.dataset.dotIndex, 10)); resetTimer(); }); });

  carousel.addEventListener('mouseenter', function() { clearInterval(timer); });
  carousel.addEventListener('mouseleave', startTimer);

  var touchStartX = 0;
  carousel.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
  carousel.addEventListener('touchend', function(e) {
    var diff = touchStartX - e.changedTouches[0].screenX;
    if (Math.abs(diff) > 50) { goTo(diff > 0 ? current + 1 : current - 1); resetTimer(); }
  }, { passive: true });

  startTimer();
})();
</script>

{% schema %}
{
  "name": "Carousel",
  "tag": "section",
  "class": "shopify-section--carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "select", "id": "image_ratio", "label": "Slide image ratio", "options": [{ "value": "16/9", "label": "Widescreen (16:9)" }, { "value": "3/1", "label": "Cinematic (3:1)" }, { "value": "4/3", "label": "Landscape (4:3)" }, { "value": "1/1", "label": "Square (1:1)" }, { "value": "3/4", "label": "Portrait (3:4)" }], "default": "16/9" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-play", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 2, "max": 10, "step": 1, "default": 5, "unit": "s" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "", "label": "None" }, { "value": "1", "label": "Scheme 1 — Light" }, { "value": "2", "label": "Scheme 2 — Dark" }, { "value": "3", "label": "Scheme 3 — Neutral" }], "default": "" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 8, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 8, "default": 64, "unit": "px" }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }], "default": "primary" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Slide one" } },
        { "type": "slide", "settings": { "heading": "Slide two" } }
      ]
    }
  ]
}
{% endschema %}
