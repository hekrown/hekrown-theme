{%- comment -%}
  Newsletter Section
  Email capture with heading, description, and optional image.
{%- endcomment -%}

<div class="section-newsletter section-padding color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-newsletter__grid section-newsletter__grid--{{ section.settings.layout }}">
      {%- if section.settings.image != blank and section.settings.layout != 'text-only' -%}
        <div class="section-newsletter__media">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.heading | escape }}"
            width="800"
            height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
            loading="lazy"
            class="section-newsletter__image"
          >
        </div>
      {%- endif -%}

      <div class="section-newsletter__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-newsletter__heading" style="color: var(--color-scheme-heading, inherit);">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="section-newsletter__description">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        {%- form 'customer', id: 'newsletter-section' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="section-newsletter__form">
            <label for="newsletter-email-{{ section.id }}" class="visually-hidden">Email address</label>
            <input
              type="email"
              id="newsletter-email-{{ section.id }}"
              name="contact[email]"
              class="section-newsletter__input"
              placeholder="{{ section.settings.placeholder }}"
              required
              aria-label="Email address"
              autocomplete="email"
            >
            <button type="submit" class="btn btn--primary section-newsletter__btn">
              {{ section.settings.button_text }}
            </button>
          </div>

          {%- if section.settings.disclaimer != blank -%}
            <p class="section-newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
  .section-newsletter__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .section-newsletter__grid--image-left {
      grid-template-columns: 1fr 1fr;
    }

    .section-newsletter__grid--image-right {
      grid-template-columns: 1fr 1fr;
    }

    .section-newsletter__grid--image-right .section-newsletter__media {
      order: 2;
    }
  }

  .section-newsletter__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
  }

  .section-newsletter__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 520px;
  }

  .section-newsletter__grid--text-only .section-newsletter__content {
    max-width: 600px;
    margin-inline: auto;
    text-align: center;
  }

  .section-newsletter__heading {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: var(--font-weight-bold);
  }

  .section-newsletter__description {
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    color: var(--color-scheme-text, var(--color-mid-grey));
  }

  .section-newsletter__form {
    display: flex;
    gap: var(--space-sm);
  }

  @media (max-width: 639px) {
    .section-newsletter__form {
      flex-direction: column;
    }
  }

  .section-newsletter__input {
    flex: 1;
    height: var(--input-height);
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-base);
    border-radius: var(--button-radius, 0px);
  }

  .section-newsletter__input:focus {
    outline: none;
    border-color: var(--color-scheme-heading, var(--color-black));
  }

  .section-newsletter__btn {
    white-space: nowrap;
    border-radius: var(--button-radius, 0px);
  }

  .section-newsletter__disclaimer {
    font-size: var(--font-size-xs);
    color: var(--color-scheme-text, var(--color-mid-grey));
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "text-only", "label": "Text only (centered)" },
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "text-only"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to receive updates, access to exclusive deals, and more."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By subscribing you agree to our Privacy Policy. Unsubscribe at any time."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
