{%- comment -%}
  Recently Viewed Products Section
  Tracks product views in localStorage and renders them.
  No app required — fully native.
{%- endcomment -%}

<div
  class="section-recently-viewed section-padding color-scheme-{{ section.settings.color_scheme }}"
  data-recently-viewed
  data-product-id="{{ product.id | default: '' }}"
  data-limit="{{ section.settings.products_to_show }}"
  style="display: none;"
>
  <div class="container">
    <h2 class="section-recently-viewed__heading" style="
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      margin-bottom: var(--space-xl);
      color: var(--color-scheme-heading, inherit);
    ">
      {{ section.settings.heading }}
    </h2>

    <div class="section-recently-viewed__grid" data-recently-viewed-grid>
      {%- comment -%} Products injected via JS {%- endcomment -%}
    </div>
  </div>
</div>

<style>
  .section-recently-viewed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gutter, 20px);
  }

  @media (min-width: 640px) {
    .section-recently-viewed__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1024px) {
    .section-recently-viewed__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .rv-card {
    text-decoration: none;
    display: block;
  }

  .rv-card__image {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    background-color: var(--color-off-white);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .rv-card__title {
    font-size: 13px;
    font-weight: var(--font-weight-medium);
    color: var(--color-scheme-heading, var(--color-black));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  .rv-card__price {
    font-size: 13px;
    font-weight: var(--font-weight-medium);
    margin-top: 4px;
    color: var(--color-scheme-text, var(--color-dark-grey));
  }
</style>

<script>
(function () {
  'use strict';

  var STORAGE_KEY = 'moss_recently_viewed';
  var MAX_ITEMS = 20;

  var section = document.querySelector('[data-recently-viewed]');
  if (!section) return;

  var currentProductId = section.dataset.productId;
  var limit = parseInt(section.dataset.limit, 10) || 4;
  var grid = section.querySelector('[data-recently-viewed-grid]');

  // ── Track current product ─────────────────────────────────────────────────
  if (currentProductId) {
    var items = getItems();
    // Remove if already exists, add to front
    items = items.filter(function (id) { return id !== currentProductId; });
    items.unshift(currentProductId);
    // Cap at MAX
    if (items.length > MAX_ITEMS) items = items.slice(0, MAX_ITEMS);
    saveItems(items);
  }

  // ── Render products ───────────────────────────────────────────────────────
  var viewedIds = getItems().filter(function (id) { return id !== currentProductId; });
  if (viewedIds.length === 0) return;

  // Show section
  section.style.display = '';

  // Fetch products and render
  fetch('/products.json?limit=250')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var products = [];
      viewedIds.slice(0, limit).forEach(function (id) {
        var p = data.products.find(function (prod) { return String(prod.id) === id; });
        if (p) products.push(p);
      });

      if (products.length === 0) {
        section.style.display = 'none';
        return;
      }

      grid.innerHTML = products.map(function (p) {
        var img = p.images[0] ? p.images[0].src : '';
        var price = formatMoney(p.variants[0].price);
        return '<a href="/products/' + p.handle + '" class="rv-card">' +
          (img ? '<img src="' + img + '" alt="' + p.title + '" class="rv-card__image" loading="lazy" width="300" height="400">' : '<div class="rv-card__image"></div>') +
          '<span class="rv-card__title">' + p.title + '</span>' +
          '<span class="rv-card__price">' + price + '</span>' +
        '</a>';
      }).join('');
    })
    .catch(function () {
      section.style.display = 'none';
    });

  function getItems() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
    catch (e) { return []; }
  }

  function saveItems(items) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(items)); } catch (e) {}
  }

  function formatMoney(cents) {
    try { return new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(Number(cents) / 100); }
    catch (e) { return '£' + (Number(cents) / 100).toFixed(2); }
  }
})();
</script>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "recently-viewed-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
