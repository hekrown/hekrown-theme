{%- comment -%}
  Main Product Section
  Two-column layout: 55-60% images left, 40-45% details right (sticky).
{%- endcomment -%}

{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-main-product.js' | asset_url }}" defer></script>

{%- comment -%}
  Serialize all variant data into a JSON script tag.
  The JS reads this to update price, availability and images on option change.
{%- endcomment -%}
<script id="product-json-{{ product.id }}" type="application/json">
  {
    "id": {{ product.id }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 'null' }},
          "available": {{ variant.available }},
          "option1": {{ variant.option1 | json }},
          "option2": {{ variant.option2 | json }},
          "option3": {{ variant.option3 | json }},
          "featured_media_id": {{ variant.featured_media.id | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "options": {{ product.options | json }},
    "money_format": {{ shop.money_format | json }}
  }
</script>

<div class="product-page section-padding" data-product-id="{{ product.id }}">
  <div class="container">
    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">&rsaquo;</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product-page__grid">
      {%- comment -%} Image Gallery (Left) {%- endcomment -%}
      <div class="product-page__media">
        <div class="product-page__gallery" data-product-gallery>
          {%- for media in product.media -%}
            <div class="product-page__media-item{% if forloop.first %} product-page__media-item--active{% endif %}" data-media-id="{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                <img
                  src="{{ media | image_url: width: 900 }}"
                  alt="{{ media.alt | escape }}"
                  width="900"
                  height="{{ 900 | divided_by: media.aspect_ratio | round }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  class="product-page__image"
                >
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Thumbnails {%- endcomment -%}
        {%- if product.media.size > 1 -%}
          <div class="product-page__thumbnails">
            {%- for media in product.media -%}
              <button
                class="product-page__thumbnail{% if forloop.first %} product-page__thumbnail--active{% endif %}"
                data-thumbnail="{{ media.id }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 100 }}"
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Details (Right — Sticky) {%- endcomment -%}
      <div class="product-page__details">
        {%- comment -%} Product header {%- endcomment -%}
        <h1 class="product-page__title">{{ product.title }}</h1>

        {%- if product.metafields.reviews.rating.value -%}
          <div class="product-page__rating">
            ★ {{ product.metafields.reviews.rating.value }} ({{ product.metafields.reviews.rating_count }} reviews)
          </div>
        {%- endif -%}

        <div class="product-page__price" data-product-price>
          {%- if product.compare_at_price > product.price -%}
            <span class="product-page__price-sale">{{ product.price | money }}</span>
            <span class="product-page__price-compare">{{ product.compare_at_price | money }}</span>
          {%- else -%}
            <span>{{ product.price | money }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Variant selectors {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="product-page__variants" data-variant-picker>
            {%- for option in product.options_with_values -%}
              <fieldset class="product-page__option">
                <legend class="product-page__option-label">
                  {{ option.name }}{% if option.name == 'Colour' or option.name == 'Color' %}: <span data-selected-color>{{ option.selected_value }}</span>{% endif %}
                  {%- if option.name == 'Size' -%}
                    <button type="button" class="product-page__size-guide-link" data-size-guide-open>{{ 'products.product.size_guide' | t }}</button>
                  {%- endif -%}
                </legend>

                <div class="product-page__option-values">
                  {%- for value in option.values -%}
                    <label class="product-page__option-value{% if option.selected_value == value %} product-page__option-value--selected{% endif %}">
                      <input
                        type="radio"
                        name="option-{{ option.name | handleize }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        class="visually-hidden"
                      >
                      <span class="product-page__option-label-text">{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%} Add to basket {%- endcomment -%}
        {%- form 'product', product, id: 'product-form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

          <div class="product-page__quantity">
            <label for="quantity" class="visually-hidden">Quantity</label>
            <button type="button" class="product-page__qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" id="quantity" name="quantity" value="1" min="1" class="product-page__qty-input" data-qty-input>
            <button type="button" class="product-page__qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <button
            type="submit"
            class="btn btn--primary btn--full-width product-page__atc"
            data-atc-btn
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.out_of_stock' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}

        {%- comment -%} Delivery & returns info {%- endcomment -%}
        <div class="product-page__info-rows">
          <div class="product-page__info-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>Free delivery on orders over £200</span>
          </div>
          <div class="product-page__info-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            <span>Easy returns & exchanges</span>
          </div>
        </div>

        {%- comment -%} Product description accordion {%- endcomment -%}
        <div class="product-page__accordions">
          {%- if product.description != blank -%}
            <details class="product-page__accordion">
              <summary class="product-page__accordion-trigger">{{ 'products.product.description' | t | default: 'Description' }}</summary>
              <div class="product-page__accordion-content">
                {{ product.description }}
              </div>
            </details>
          {%- endif -%}

          {%- if product.metafields.custom.details -%}
            <details class="product-page__accordion">
              <summary class="product-page__accordion-trigger">{{ 'products.product.product_details' | t | default: 'Product Details' }}</summary>
              <div class="product-page__accordion-content">
                {{ product.metafields.custom.details | metafield_tag }}
              </div>
            </details>
          {%- endif -%}

          <details class="product-page__accordion">
            <summary class="product-page__accordion-trigger">{{ 'products.product.delivery_returns' | t | default: 'Delivery & Returns' }}</summary>
            <div class="product-page__accordion-content">
              <p>Free UK standard delivery on orders over £200. Express delivery available. Easy returns within 30 days of purchase.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} Sticky ATC bar for mobile {%- endcomment -%}
<div class="product-page__sticky-atc" data-sticky-atc aria-hidden="true">
  <div class="product-page__sticky-atc-inner">
    <span class="product-page__sticky-atc-title">{{ product.title }}</span>
    <span class="product-page__sticky-atc-price" data-sticky-price>{{ product.price | money }}</span>
    <button
      type="button"
      class="btn btn--primary product-page__sticky-atc-btn"
      data-sticky-atc-btn
      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      {%- if product.selected_or_first_available_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.out_of_stock' | t }}
      {%- endif -%}
    </button>
  </div>
</div>

{%- comment -%} Back in stock notification form {%- endcomment -%}
{%- unless product.available -%}
  <div class="product-page__notify" id="product-notify-form">
    <p class="product-page__notify-text">This product is currently out of stock.</p>
    {%- form 'contact', id: 'notify-form' -%}
      <input type="hidden" name="contact[body]" value="Back in stock notification request for: {{ product.title }} — {{ product.url | prepend: shop.url }}">
      <input type="hidden" name="contact[tags]" value="back-in-stock">
      <div class="product-page__notify-row">
        <label for="notify-email" class="visually-hidden">Email address</label>
        <input
          type="email"
          id="notify-email"
          name="contact[email]"
          class="input"
          placeholder="Enter your email"
          required
          aria-label="Email address for back-in-stock notification"
        >
        <button type="submit" class="btn btn--primary">{{ 'products.product.notify_me' | t | default: 'Notify Me' }}</button>
      </div>
      <p class="product-page__notify-disclaimer">We'll email you when this product is back in stock.</p>
    {%- endform -%}
  </div>
{%- endunless -%}

<style>
  /* Sticky ATC bar — mobile only */
  .product-page__sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
    padding: var(--space-md);
    transform: translateY(100%);
    transition: transform var(--transition-normal);
    box-shadow: 0 -2px 16px rgba(0,0,0,0.08);
  }

  .product-page__sticky-atc.is-visible {
    transform: translateY(0);
  }

  @media (min-width: 1024px) {
    .product-page__sticky-atc {
      display: none;
    }
  }

  .product-page__sticky-atc-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .product-page__sticky-atc-title {
    flex: 1;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-page__sticky-atc-price {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .product-page__sticky-atc-btn {
    white-space: nowrap;
    padding: 12px 20px;
    font-size: var(--font-size-sm);
  }

  /* Back in stock form */
  .product-page__notify {
    background-color: var(--color-off-white);
    padding: var(--space-lg);
    margin-top: var(--space-md);
  }

  .product-page__notify-text {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-md);
  }

  .product-page__notify-row {
    display: flex;
    gap: var(--space-sm);
  }

  .product-page__notify-row .input {
    flex: 1;
  }

  .product-page__notify-disclaimer {
    font-size: var(--font-size-xs);
    color: var(--color-mid-grey);
    margin-top: var(--space-sm);
  }
</style>

<script>
(function () {
  var stickyBar = document.querySelector('[data-sticky-atc]');
  var atcBtn    = document.querySelector('[data-atc-btn]');
  var stickyBtn = document.querySelector('[data-sticky-atc-btn]');
  var form      = document.querySelector('[data-product-form]');

  if (!stickyBar || !atcBtn) return;

  // Show sticky bar when main ATC button scrolls out of view
  var observer = new IntersectionObserver(function (entries) {
    var visible = entries[0].isIntersecting;
    stickyBar.classList.toggle('is-visible', !visible);
    stickyBar.setAttribute('aria-hidden', visible ? 'true' : 'false');
  }, { threshold: 0 });

  observer.observe(atcBtn);

  // Sticky bar button triggers the main form submit
  stickyBtn && stickyBtn.addEventListener('click', function () {
    if (form) form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
  });

  // Keep sticky price and state in sync with variant changes
  document.addEventListener('variant:changed', function (e) {
    var variant = e.detail.variant;
    if (!variant) return;

    var priceEl = document.querySelector('[data-sticky-price]');
    if (priceEl && variant.price) {
      var format = window.MossTheme && window.MossTheme.moneyFormat;
      if (format) {
        var amount = (variant.price / 100).toFixed(2);
        priceEl.textContent = format.replace(/\{\{\s*amount\s*\}\}/, amount);
      } else {
        priceEl.textContent = '£' + (variant.price / 100).toFixed(2);
      }
    }
    if (stickyBtn) {
      stickyBtn.disabled = !variant.available;
      stickyBtn.textContent = variant.available ? 'Add to Basket' : 'Out of Stock';
    }
  });
})();
</script>
<div class="size-guide-modal" id="size-guide-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="size-guide-title" data-size-guide>
  <div class="size-guide-modal__overlay" data-size-guide-close></div>
  <div class="size-guide-modal__panel">
    <div class="size-guide-modal__header">
      <h2 class="size-guide-modal__title" id="size-guide-title">Size Guide</h2>
      <button class="size-guide-modal__close" aria-label="Close size guide" data-size-guide-close>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="1.5"/>
          <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
    </div>
    <div class="size-guide-modal__body">
      {%- if product.metafields.custom.size_guide -%}
        {{ product.metafields.custom.size_guide | metafield_tag }}
      {%- else -%}
        <table class="size-guide-modal__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest (in)</th>
              <th>Waist (in)</th>
              <th>Hip (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>XS</td><td>34–36</td><td>28–30</td><td>34–36</td></tr>
            <tr><td>S</td><td>36–38</td><td>30–32</td><td>36–38</td></tr>
            <tr><td>M</td><td>38–40</td><td>32–34</td><td>38–40</td></tr>
            <tr><td>L</td><td>40–42</td><td>34–36</td><td>40–42</td></tr>
            <tr><td>XL</td><td>42–44</td><td>36–38</td><td>42–44</td></tr>
            <tr><td>XXL</td><td>44–46</td><td>38–40</td><td>44–46</td></tr>
          </tbody>
        </table>
        <p class="size-guide-modal__note">All measurements are in inches. If between sizes, size up.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .product-page__size-guide-link {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-regular);
    color: var(--color-mid-grey);
    text-decoration: underline;
    margin-left: var(--space-sm);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .product-page__size-guide-link:hover {
    color: var(--color-black);
  }

  /* Size guide modal */
  .size-guide-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 2000;
    align-items: center;
    justify-content: center;
  }

  .size-guide-modal.is-open {
    display: flex;
  }

  .size-guide-modal__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0,0,0,0.5);
  }

  .size-guide-modal__panel {
    position: relative;
    z-index: 1;
    background-color: var(--color-white);
    width: 90%;
    max-width: 560px;
    max-height: 80vh;
    overflow-y: auto;
    padding: var(--space-xl);
  }

  .size-guide-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .size-guide-modal__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }

  .size-guide-modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-black);
    cursor: pointer;
  }

  .size-guide-modal__close:hover { opacity: 0.6; }

  .size-guide-modal__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .size-guide-modal__table th,
  .size-guide-modal__table td {
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .size-guide-modal__table th {
    font-weight: var(--font-weight-semibold);
    background-color: var(--color-off-white);
  }

  .size-guide-modal__note {
    margin-top: var(--space-md);
    font-size: var(--font-size-sm);
    color: var(--color-mid-grey);
  }
</style>

<script>
(function () {
  var modal     = document.querySelector('[data-size-guide]');
  var openBtns  = document.querySelectorAll('[data-size-guide-open]');
  var closeBtns = document.querySelectorAll('[data-size-guide-close]');
  if (!modal) return;

  var lastFocus = null;
  var focusableSelectors = 'a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])';

  function getFocusable() {
    return Array.from(modal.querySelectorAll(focusableSelectors)).filter(function (el) {
      return !el.closest('[aria-hidden="true"]');
    });
  }

  function trapFocus(e) {
    if (e.key !== 'Tab') return;
    var focusable = getFocusable();
    if (!focusable.length) return;
    var first = focusable[0];
    var last  = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  }

  function openModal() {
    lastFocus = document.activeElement;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('nav-open');
    modal.addEventListener('keydown', trapFocus);
    var closeBtn = modal.querySelector('[data-size-guide-close]');
    if (closeBtn) closeBtn.focus();
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('nav-open');
    modal.removeEventListener('keydown', trapFocus);
    if (lastFocus) lastFocus.focus();
  }

  openBtns.forEach(function (btn) { btn.addEventListener('click', openModal); });
  closeBtns.forEach(function (btn) { btn.addEventListener('click', closeModal); });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });
})();
</script>

{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_details",
      "label": "Sticky product details (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ]
}
{% endschema %}
