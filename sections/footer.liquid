<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div class="site-footer__column" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="site-footer__column-heading">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.type == 'link_list' -%}
            <ul class="site-footer__links">
              {%- for link in block.settings.menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif block.type == 'text' -%}
            <div class="site-footer__text">
              {{ block.settings.content }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Newsletter {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="site-footer__newsletter">
        <h3 class="site-footer__column-heading">{{ section.settings.newsletter_heading }}</h3>
        {%- form 'customer', id: 'footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <input
              type="email"
              name="contact[email]"
              class="site-footer__newsletter-input"
              placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
              required
              aria-label="{{ 'general.newsletter.email_placeholder' | t }}"
            >
            <button type="submit" class="site-footer__newsletter-btn">{{ 'general.newsletter.subscribe' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="site-footer__payment-icons">
        {{ shop.enabled_payment_types | payment_type_svg_tag }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Your brand story here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "text", "settings": { "heading": "About" } },
        { "type": "link_list", "settings": { "heading": "Help & Info" } },
        { "type": "link_list", "settings": { "heading": "My Account" } },
        { "type": "link_list", "settings": { "heading": "Services" } }
      ]
    }
  ]
}
{% endschema %}
