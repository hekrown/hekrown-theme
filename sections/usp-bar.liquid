{%- comment -%}
  Trust / USP Bar
  Horizontal row of 3-4 trust icons with text.
{%- endcomment -%}

<div class="usp-bar color-scheme-{{ section.settings.color_scheme }}" style="{% if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' %}background-color:{{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank and section.settings.text_color != 'rgba(0,0,0,0)' %}color:{{ section.settings.text_color }};{% endif %}padding-top:{{ section.settings.padding_top | default: 40 }}px;padding-bottom:{{ section.settings.padding_bottom | default: 40 }}px;">
  <div class="container">
    <div class="usp-bar__grid">
      {%- for block in section.blocks -%}
        <div class="usp-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="usp-bar__icon">
              {{ block.settings.icon }}
            </div>
          {%- endif -%}
          <h3 class="usp-bar__heading" style="color: {{ section.settings.text_color }};">
            {{ block.settings.heading }}
          </h3>
          {%- if block.settings.text != blank -%}
            <p class="usp-bar__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .usp-bar__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    text-align: center;
  }

  @media (min-width: 640px) {
    .usp-bar__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .usp-bar__grid {
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    }
  }

  .usp-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .usp-bar__icon svg {
    width: 32px;
    height: 32px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }

  .usp-bar__heading {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .usp-bar__text {
    font-size: var(--font-size-sm);
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "USP bar",
  "tag": "section",
  "class": "usp-bar-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text override"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 80, "step": 8, "default": 40, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 80, "step": 8, "default": 40, "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "usp",
      "name": "USP item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "On orders over £200"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP bar",
      "blocks": [
        { "type": "usp", "settings": { "heading": "Free Delivery", "text": "On orders over £200" } },
        { "type": "usp", "settings": { "heading": "Easy Returns", "text": "30-day return policy" } },
        { "type": "usp", "settings": { "heading": "170 Years", "text": "Of tailoring heritage" } }
      ]
    }
  ]
}
{% endschema %}
