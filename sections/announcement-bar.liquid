{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" role="region" aria-label="{{ 'sections.announcement_bar.label' | t }}">
  <div class="announcement-bar__inner">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="announcement-bar__message" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </a>
      {%- unless forloop.last -%}
        <span class="announcement-bar__separator" aria-hidden="true">|</span>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free delivery over £200"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free delivery over £200" } },
        { "type": "message", "settings": { "text": "Easy returns & exchanges" } },
        { "type": "message", "settings": { "text": "170 years of tailoring heritage" } }
      ]
    }
  ]
}
{% endschema %}
