{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" role="region" aria-label="Announcements" data-announcement-bar>
  {%- if section.blocks.size == 1 -%}
    {%- comment -%} Single message — static centred {%- endcomment -%}
    <div class="announcement-bar__inner">
      <a href="{{ section.blocks[0].settings.link }}" class="announcement-bar__message">
        {{ section.blocks[0].settings.text }}
      </a>
    </div>
  {%- else -%}
    {%- comment -%} Multiple messages — JS ticker {%- endcomment -%}
    <div class="announcement-bar__ticker" data-ticker>
      <div class="announcement-bar__ticker-track" data-ticker-track>
        {%- for block in section.blocks -%}
          <span class="announcement-bar__ticker-item{% if forloop.first %} is-active{% endif %}" data-ticker-item {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>

      {%- comment -%} Prev/Next + Pause controls {%- endcomment -%}
      <button class="announcement-bar__ticker-btn announcement-bar__ticker-btn--prev" data-ticker-prev aria-label="{{ 'accessibility.previous' | t }}">&#8249;</button>
      <button
        class="announcement-bar__ticker-btn announcement-bar__ticker-btn--pause"
        data-ticker-pause
        aria-label="{{ 'announcement_bar.pause' | t | default: 'Pause announcements' }}"
        aria-pressed="false"
      >
        <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true" fill="currentColor">
          <rect x="3" y="2" width="3" height="12"/>
          <rect x="10" y="2" width="3" height="12"/>
        </svg>
      </button>
      <button class="announcement-bar__ticker-btn announcement-bar__ticker-btn--next" data-ticker-next aria-label="{{ 'accessibility.next' | t }}">&#8250;</button>
    </div>
  {%- endif -%}
</div>

<style>
  .announcement-bar__ticker {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .announcement-bar__ticker-track {
    position: relative;
    width: 100%;
    text-align: center;
  }

  .announcement-bar__ticker-item {
    display: none;
    width: 100%;
    text-align: center;
    animation: ticker-fade-in 0.4s ease;
  }

  .announcement-bar__ticker-item.is-active {
    display: inline-block;
  }

  .announcement-bar__ticker-item a {
    color: var(--color-white);
    text-decoration: none;
  }

  .announcement-bar__ticker-item a:hover {
    text-decoration: underline;
  }

  @keyframes ticker-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .announcement-bar__ticker-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--color-white);
    font-size: 18px;
    padding: 0 var(--space-sm);
    cursor: pointer;
    opacity: 0.7;
    line-height: 1;
  }

  .announcement-bar__ticker-btn:hover { opacity: 1; }
  .announcement-bar__ticker-btn--prev { left: var(--space-md); }
  .announcement-bar__ticker-btn--next { right: var(--space-md); }
  .announcement-bar__ticker-btn--pause {
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .announcement-bar:hover .announcement-bar__ticker-btn--pause,
  .announcement-bar__ticker-btn--pause:focus-visible {
    opacity: 0.7;
  }
  .announcement-bar__ticker-btn--pause[aria-pressed="true"] {
    opacity: 1;
  }
</style>

<script>
(function () {
  var bar       = document.querySelector('[data-ticker]');
  if (!bar) return;

  var items     = Array.from(bar.querySelectorAll('[data-ticker-item]'));
  var prevBtn   = bar.querySelector('[data-ticker-prev]');
  var nextBtn   = bar.querySelector('[data-ticker-next]');
  var pauseBtn  = bar.querySelector('[data-ticker-pause]');
  var current   = 0;
  var interval  = {{ section.settings.interval | times: 1000 }};
  var timer;
  var paused    = false;

  // Respect prefers-reduced-motion
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function show(index) {
    items[current].classList.remove('is-active');
    current = (index + items.length) % items.length;
    items[current].classList.add('is-active');
  }

  function startTimer() {
    if (prefersReduced || paused) return;
    timer = setInterval(function () { show(current + 1); }, interval);
  }

  function stopTimer() { clearInterval(timer); }

  function resetTimer() { stopTimer(); startTimer(); }

  function togglePause() {
    paused = !paused;
    pauseBtn.setAttribute('aria-pressed', String(paused));
    if (paused) { stopTimer(); } else { startTimer(); }
  }

  if (prevBtn)  prevBtn.addEventListener('click',  function () { show(current - 1); resetTimer(); });
  if (nextBtn)  nextBtn.addEventListener('click',  function () { show(current + 1); resetTimer(); });
  if (pauseBtn) pauseBtn.addEventListener('click', togglePause);

  if (!prefersReduced) startTimer();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per message",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free delivery over £200"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free delivery over £200" } },
        { "type": "message", "settings": { "text": "Easy returns & exchanges" } },
        { "type": "message", "settings": { "text": "170 years of tailoring heritage" } }
      ]
    }
  ]
}
{% endschema %}
