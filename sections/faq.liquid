{%- comment -%}
  FAQ Section
  Accordion-style Q&A with JSON-LD FAQPage schema for SEO.
  Each FAQ item is a block — merchants add/remove/reorder freely.
{%- endcomment -%}

<div class="section-faq section-padding color-scheme-{{ section.settings.color_scheme }}">
  <div class="section-faq__container" style="--faq-width:{{ section.settings.content_width }}px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-faq__heading section-faq__heading--{{ section.settings.heading_alignment }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="section-faq__subheading section-faq__subheading--{{ section.settings.heading_alignment }}">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    <div class="section-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="section-faq__item" {{ block.shopify_attributes }}>
            <summary class="section-faq__question">
              <span>{{ block.settings.question }}</span>
              <svg class="section-faq__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="1.5"/>
                <line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </summary>
            <div class="section-faq__answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
  </div>
</div>

{%- comment -%} JSON-LD FAQPage Schema for SEO {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' and block.settings.question != blank -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<style>
  .section-faq__container {
    max-width: var(--faq-width, 800px);
    margin-inline: auto;
  }

  .section-faq__heading {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-sm);
    color: var(--color-scheme-heading, inherit);
  }

  .section-faq__subheading {
    color: var(--color-scheme-text, var(--color-mid-grey));
    margin-bottom: var(--space-xl);
    font-size: var(--font-size-base);
  }

  .section-faq__heading--left,
  .section-faq__subheading--left   { text-align: left; }
  .section-faq__heading--center,
  .section-faq__subheading--center { text-align: center; }

  .section-faq__list {
    border-top: 1px solid var(--color-border);
  }

  .section-faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .section-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    list-style: none;
    color: var(--color-scheme-heading, var(--color-black));
  }

  .section-faq__question::-webkit-details-marker {
    display: none;
  }

  .section-faq__icon {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .section-faq__item[open] .section-faq__icon {
    transform: rotate(45deg);
  }

  .section-faq__answer {
    padding-bottom: var(--space-lg);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    color: var(--color-scheme-text, var(--color-dark-grey));
    max-width: 720px;
  }

  .section-faq__answer p {
    margin-bottom: var(--space-md);
  }

  .section-faq__answer p:last-child {
    margin-bottom: 0;
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 (Light)" },
        { "value": "2", "label": "Scheme 2 (Dark)" },
        { "value": "3", "label": "Scheme 3 (Neutral)" }
      ],
      "default": "1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 500,
      "max": 1000,
      "step": 50,
      "default": 800,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer free returns within 30 days of purchase. Items must be unworn and in original packaging.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>We offer free returns within 30 days of purchase. Items must be unworn and in original packaging.</p>" } },
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Standard delivery takes 3-5 working days. Express delivery is available for next-day arrival.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes, we ship to over 50 countries worldwide. International delivery typically takes 7-14 working days.</p>" } },
        { "type": "question", "settings": { "question": "How do I track my order?", "answer": "<p>Once your order has been dispatched, you'll receive an email with a tracking link. You can also check your order status in your account.</p>" } }
      ]
    }
  ]
}
{% endschema %}
