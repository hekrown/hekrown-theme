<div class="password-page section-padding">
  <div class="container text-center">
    <h1>{{ shop.name }}</h1>
    <p style="color: var(--color-mid-grey); margin-top: var(--space-md);">
      We're getting things ready. Enter the password to access the store.
    </p>
    {%- form 'storefront_password', class: 'password-form' -%}
      <div style="display: flex; gap: var(--space-sm); justify-content: center; margin-top: var(--space-xl); max-width: 400px; margin-inline: auto;">
        <input type="password" name="password" class="input" placeholder="Password" required>
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
      {%- if form.errors -%}
        <p style="color: var(--color-red); margin-top: var(--space-md); font-size: var(--font-size-sm);">
          {{ form.errors.messages['password'] }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ]
}
{% endschema %}
