{%- comment -%}
  Product Split Layout
  Full-width gallery on left, details on right (50/50 split, no container)
{%- endcomment -%}

{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-main-product.js' | asset_url }}" defer></script>

<script id="product-json-{{ product.id }}" type="application/json">
  {
    "id": {{ product.id }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 'null' }},
          "available": {{ variant.available }},
          "option1": {{ variant.option1 | json }},
          "option2": {{ variant.option2 | json }},
          "option3": {{ variant.option3 | json }},
          "featured_media_id": {{ variant.featured_media.id | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "options": {{ product.options | json }},
    "money_format": {{ shop.money_format | json }}
  }
</script>

<div class="product-split" data-product-id="{{ product.id }}">
  {%- comment -%} Full-width Gallery {%- endcomment -%}
  <div class="product-split__gallery">
    <div class="product-split__media" data-product-gallery>
      {%- for media in product.media -%}
        <div class="product-split__media-item{% if forloop.first %} product-split__media-item--active{% endif %}" data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            <img
              src="{{ media | image_url: width: 1400 }}"
              alt="{{ media.alt | escape }}"
              width="1400"
              height="{{ 1400 | divided_by: media.aspect_ratio | round }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              class="product-split__image"
            >
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="product-split__thumbnails">
        {%- for media in product.media -%}
          <button
            class="product-split__thumbnail{% if forloop.first %} product-split__thumbnail--active{% endif %}"
            data-thumbnail="{{ media.id }}"
            aria-label="View image {{ forloop.index }}"
          >
            <img
              src="{{ media | image_url: width: 100 }}"
              alt=""
              width="60"
              height="60"
              loading="lazy"
            >
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Product Details {%- endcomment -%}
  <div class="product-split__details">
    <div class="product-split__details-inner">
      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="product-page__price" data-product-price>
        {%- if product.compare_at_price > product.price -%}
          <span class="product-page__price-sale">{{ product.price | money }}</span>
          <span class="product-page__price-compare">{{ product.compare_at_price | money }}</span>
        {%- else -%}
          <span>{{ product.price | money }}</span>
        {%- endif -%}
      </div>

      {%- unless product.has_only_default_variant -%}
        <div class="product-page__variants" data-variant-picker>
          {%- for option in product.options_with_values -%}
            <fieldset class="product-page__option">
              <legend class="product-page__option-label">
                {{ option.name }}{% if option.name == 'Colour' or option.name == 'Color' %}: <span data-selected-color>{{ option.selected_value }}</span>{% endif %}
                {%- if option.name == 'Size' -%}
                  <button type="button" class="product-page__size-guide-link" data-size-guide-open>Size Guide</button>
                {%- endif -%}
              </legend>
              <div class="product-page__option-values">
                {%- for value in option.values -%}
                  <label class="product-page__option-value{% if option.selected_value == value %} product-page__option-value--selected{% endif %}">
                    <input
                      type="radio"
                      name="option-{{ option.name | handleize }}"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                      class="visually-hidden"
                    >
                    <span class="product-page__option-label-text">{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- form 'product', product, id: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        <div class="product-page__quantity">
          <label for="quantity" class="visually-hidden">Quantity</label>
          <button type="button" class="product-page__qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
          <input type="number" id="quantity" name="quantity" value="1" min="1" class="product-page__qty-input" data-qty-input>
          <button type="button" class="product-page__qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
        </div>

        <button
          type="submit"
          class="btn btn--primary btn--full-width product-page__atc"
          data-atc-btn
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {%- if product.selected_or_first_available_variant.available -%}
            Add to Basket
          {%- else -%}
            Out of Stock
          {%- endif -%}
        </button>
      {%- endform -%}

      <div class="product-page__info-rows">
        <div class="product-page__info-row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Free delivery on orders over £200</span>
        </div>
        <div class="product-page__info-row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          <span>Easy returns & exchanges</span>
        </div>
      </div>

      <div class="product-page__accordions">
        {%- if product.description != blank -%}
          <details class="product-page__accordion">
            <summary class="product-page__accordion-trigger">Description</summary>
            <div class="product-page__accordion-content">
              {{ product.description }}
            </div>
          </details>
        {%- endif -%}

        <details class="product-page__accordion">
          <summary class="product-page__accordion-trigger">Delivery & Returns</summary>
          <div class="product-page__accordion-content">
            <p>Free UK standard delivery on orders over £200. Express delivery available. Easy returns within 30 days of purchase.</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</div>

<style>
  .product-split {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .product-split {
      grid-template-columns: 1fr 480px;
      min-height: 100vh;
    }
  }

  .product-split__gallery {
    position: relative;
    background-color: var(--color-off-white);
  }

  .product-split__media {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1023px) {
    .product-split__media {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .product-split__media-item {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
  }

  .product-split__image {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 1024px) {
    .product-split__media-item {
      display: none;
    }

    .product-split__media-item--active {
      display: block;
    }
  }

  .product-split__thumbnails {
    position: absolute;
    bottom: var(--space-lg);
    left: var(--space-lg);
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    max-width: calc(100% - var(--space-2xl));
  }

  .product-split__thumbnail {
    width: 60px;
    height: 60px;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--transition-fast), border-color var(--transition-fast);
    background: var(--color-white);
  }

  .product-split__thumbnail--active,
  .product-split__thumbnail:hover {
    opacity: 1;
    border-color: var(--color-black);
  }

  .product-split__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-split__details {
    background-color: var(--color-white);
  }

  .product-split__details-inner {
    padding: var(--space-2xl) var(--container-padding-mobile);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .product-split__details-inner {
      padding: var(--space-3xl) var(--space-2xl);
      position: sticky;
      top: 100px;
    }
  }
</style>

{% schema %}
{
  "name": "Product (Split Layout)",
  "tag": "section",
  "class": "main-product-split-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_details",
      "label": "Sticky product details (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    }
  ]
}
{% endschema %}
